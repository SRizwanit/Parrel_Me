<?xml version="1.0" encoding="utf-8"?>
<animation-list
    android:oneshot="false"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:duration="25">
        <rotate
            android:fromDegrees="0.0"
            android:toDegrees="5.0"
            android:pivotX="100.0%"
            android:pivotY="100.0%">
            <bitmap
                android:src="@drawable/icon_crown" />
        </rotate>
    </item>
    <item
        android:duration="50">
        <rotate
            android:fromDegrees="5.0"
            android:toDegrees="10.0"
            android:pivotX="100.0%"
            android:pivotY="100.0%">
            <bitmap
                android:src="@drawable/icon_crown" />
        </rotate>
    </item>
    <item
        android:duration="50">
        <rotate
            android:fromDegrees="10.0"
            android:toDegrees="5.0"
            android:pivotX="100.0%"
            android:pivotY="100.0%">
            <bitmap
                android:src="@drawable/icon_crown" />
        </rotate>
    </item>
    <item
        android:duration="50">
        <rotate
            android:fromDegrees="5.0"
            android:toDegrees="0.0"
            android:pivotX="100.0%"
            android:pivotY="100.0%">
            <bitmap
                android:src="@drawable/icon_crown" />
        </rotate>
    </item>
    <item
        android:duration="50">
        <rotate
            android:fromDegrees="0.0"
            android:toDegrees="-5.0"
            android:pivotX="0.0%"
            android:pivotY="100.0%">
            <bitmap
                android:src="@drawable/icon_crown" />
        </rotate>
    </item>
    <item
        android:duration="50">
        <rotate
            android:fromDegrees="-5.0"
            android:toDegrees="-10.0"
            android:pivotX="0.0%"
            android:pivotY="100.0%">
            <bitmap
                android:src="@drawable/icon_crown" />
        </rotate>
    </item>
    <item
        android:duration="50">
        <rotate
            android:fromDegrees="-10.0"
            android:toDegrees="-5.0"
            android:pivotX="0.0%"
            android:pivotY="100.0%">
            <bitmap
                android:src="@drawable/icon_crown" />
        </rotate>
    </item>
    <item
        android:duration="50">
        <rotate
            android:fromDegrees="-5.0"
            android:toDegrees="0.0"
            android:pivotX="0.0%"
            android:pivotY="100.0%">
            <bitmap
                android:src="@drawable/icon_crown" />
        </rotate>
    </item>
    <item
        android:duration="25">
        <rotate
            android:fromDegrees="0.0"
            android:toDegrees="5.0"
            android:pivotX="100.0%"
            android:pivotY="100.0%">
            <bitmap
                android:src="@drawable/icon_crown" />
        </rotate>
    </item>
</animation-list>