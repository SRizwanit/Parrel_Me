<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:id="@id/activity_ali_web_view"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@id/top"
            android:background="@color/add_title_bg"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/add_title_height">
            <ImageView
                android:id="@id/web_back"
                android:paddingLeft="16.0dip"
                android:paddingRight="16.0dip"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:src="@drawable/button_back_normal" />
            <TextView
                android:textSize="20.0sp"
                android:textColor="@color/app_title_white"
                android:id="@id/web_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pay_mm"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true" />
            <Button
                android:textSize="14.0sp"
                android:textColor="@color/app_title_white"
                android:id="@id/btn_complete"
                android:background="@null"
                android:paddingLeft="16.0dip"
                android:paddingRight="16.0dip"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:text="@string/menu_over"
                android:layout_alignParentRight="true" />
        </RelativeLayout>
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@id/rl_red_pocket"
            android:background="@color/add_title_bg"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/add_title_height">
            <ImageView
                android:id="@id/iv_red_pocket_back"
                android:paddingLeft="@dimen/add_back_padding_left"
                android:paddingRight="@dimen/add_back_padding_left"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:src="@drawable/button_back"
                android:layout_centerVertical="true" />
            <ImageView
                android:id="@id/iv_red_pocket_close"
                android:paddingLeft="@dimen/add_back_padding_left"
                android:paddingRight="@dimen/add_back_padding_left"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:src="@drawable/close"
                android:layout_alignParentRight="true" />
        </RelativeLayout>
        <ProgressBar
            android:id="@id/pg_bar"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="3.0dip"
            android:progressDrawable="@drawable/pg_bar"
            style="?android:progressBarStyleHorizontal" />
        <WebView
            android:id="@id/wv_ali"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent" />
    </LinearLayout>
    <TextView
        android:layout_gravity="center"
        android:id="@id/tv_show"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true" />
</FrameLayout>