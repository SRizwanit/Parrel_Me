<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:orientation="vertical"
    android:id="@id/LinearLayout1"
    android:background="@color/forget_password_bg_color"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/title_layout"
        android:background="@color/add_title_bg"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/add_title_height">
        <ImageView
            android:id="@id/ib_back"
            android:background="@android:color/transparent"
            android:paddingLeft="16.0dip"
            android:paddingRight="32.0dip"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent" />
        <TextView
            android:textSize="18.0sp"
            android:textColor="@color/text_color_white"
            android:id="@id/title"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/forget_title" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_below="@id/title_layout">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="fill_parent"
            android:layout_height="40.0dip"
            android:layout_marginTop="8.0dip">
            <TextView
                android:textSize="13.0sp"
                android:textColor="@color/add_game_app_color"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16.0dip"
                android:text="@string/forget_hint" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="fill_parent"
            android:layout_height="56.0dip">
            <EditText
                android:textSize="16.0sp"
                android:textColor="@color/add_game_app_color"
                android:textColorHint="@color/full_text_color"
                android:id="@id/send_edit"
                android:background="@null"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16.0dip"
                android:hint="@string/seting_eamil_hint" />
        </LinearLayout>
        <TextView
            android:textSize="13.0sp"
            android:textColor="@color/add_game_app_color"
            android:gravity="center"
            android:id="@id/hint_tv_forget"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10.0dip"
            android:text="@string/email_error" />
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="fill_parent"
            android:layout_height="48.0dip">
            <Button
                android:textSize="16.0sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:id="@id/send_but"
                android:background="@drawable/user_button_bg_selector"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginLeft="16.0dip"
                android:layout_marginRight="16.0dip"
                android:text="@string/forget_send" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="fill_parent"
            android:layout_height="40.0dip"
            android:layout_marginTop="16.0dip">
            <TextView
                android:textSize="13.0sp"
                android:textColor="@color/add_game_app_color"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16.0dip"
                android:text="@string/forget_verify" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="fill_parent"
            android:layout_height="40.0dip"
            android:layout_marginTop="16.0dip">
            <EditText
                android:textSize="16.0sp"
                android:textColor="@color/add_game_app_color"
                android:textColorHint="@color/full_text_color"
                android:id="@id/code_edit"
                android:background="@null"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16.0dip"
                android:hint="@string/forget_verify_code" />
        </LinearLayout>
        <TextView
            android:textSize="13.0sp"
            android:textColor="@android:color/holo_red_light"
            android:gravity="center"
            android:id="@id/hint_tv_code"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10.0dip"
            android:text="@string/code_error" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <View
                android:background="@color/full_line_color"
                android:layout_width="fill_parent"
                android:layout_height="1.0dip"
                android:layout_marginLeft="16.0dip"
                android:layout_marginRight="16.0dip" />
            <Button
                android:textSize="16.0sp"
                android:textStyle="bold"
                android:textColor="@color/text_color_white"
                android:id="@id/code_but"
                android:background="@drawable/user_button_bg_selector"
                android:layout_width="fill_parent"
                android:layout_height="48.0dip"
                android:layout_marginLeft="16.0dip"
                android:layout_marginTop="16.0dip"
                android:layout_marginRight="16.0dip"
                android:text="@string/forget_pass_reset" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:background="#32000000"
        android:layout_width="fill_parent"
        android:layout_height="2.0dip"
        android:layout_below="@id/title_layout" />
</RelativeLayout>