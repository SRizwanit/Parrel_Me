<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/activity_image_show"
    android:background="@color/user_center_bg"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/top"
        android:background="@color/add_title_bg"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/add_title_height">
        <ImageView
            android:id="@id/iv_back"
            android:paddingLeft="16.0dip"
            android:paddingTop="5.0dip"
            android:paddingRight="16.0dip"
            android:paddingBottom="5.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/button_back_normal"
            android:layout_centerVertical="true" />
        <TextView
            android:textSize="@dimen/add_list_title_text_size"
            android:textColor="@color/text_color_white"
            android:id="@id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/user_select_image"
            android:layout_centerInParent="true" />
    </RelativeLayout>
    <FrameLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/top">
        <GridView
            android:id="@id/gv_image_show"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:horizontalSpacing="3.0dip"
            android:verticalSpacing="3.0dip"
            android:numColumns="3" />
    </FrameLayout>
    <FrameLayout
        android:id="@id/fl_bg"
        android:background="#66000000"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />
    <RelativeLayout
        android:id="@id/rl_bottom_selector"
        android:background="@color/add_title_bg"
        android:layout_width="fill_parent"
        android:layout_height="46.0dip"
        android:layout_alignParentBottom="true">
        <TextView
            android:textColor="@color/text_color_white"
            android:gravity="center_vertical"
            android:id="@id/tv_folder_select"
            android:padding="10.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/user_all_images"
            android:includeFontPadding="false"
            android:drawableRight="@drawable/arrow_white"
            android:drawablePadding="6.0dip"
            android:layout_centerVertical="true" />
    </RelativeLayout>
</RelativeLayout>