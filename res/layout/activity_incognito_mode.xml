<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:background="@color/app_title_white"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@id/title"
        android:background="@color/incognito_title_bg"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/add_title_height">
        <ImageView
            android:id="@id/iv_back"
            android:background="@null"
            android:paddingLeft="@dimen/add_back_padding_left"
            android:paddingRight="32.0dip"
            android:layout_width="68.0dip"
            android:layout_height="fill_parent"
            android:src="@drawable/button_back"
            android:scaleType="fitCenter"
            android:layout_centerVertical="true" />
        <TextView
            android:textSize="@dimen/add_list_title_text_size"
            android:textColor="@color/incognito_title_text"
            android:id="@id/tv_title"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@id/iv_back"
            android:layout_centerVertical="true" />
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/layout_incognito_intro"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginTop="@dimen/add_title_height">
        <ImageView
            android:layout_width="75.0dip"
            android:layout_height="75.0dip"
            android:layout_marginTop="8.0dip"
            android:src="@drawable/ic_ennable_incognito_background"
            android:layout_marginEnd="8.0dip"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@id/layout_incognito_transform"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="68.0dip"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@id/iv_incognito_app_icon"
                    android:layout_width="64.0dip"
                    android:layout_height="64.0dip"
                    android:src="@mipmap/launcher_icon"
                    app:shapeAppearance="@style/Rounded12ShapeStyle" />
                <TextView
                    android:textSize="13.0sp"
                    android:textColor="#ff333333"
                    android:id="@id/tv_incognito_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dip"
                    android:text="@string/da_app_name" />
            </LinearLayout>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@id/iv_incognito_arrow"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:layout_marginLeft="30.0dip"
                android:layout_marginRight="30.0dip"
                android:layout_marginBottom="12.0dip"
                android:src="@drawable/ic_incognito_arrow_right"
                android:layout_marginHorizontal="30.0dip" />
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@id/iv_calculator"
                    android:layout_width="64.0dip"
                    android:layout_height="64.0dip"
                    android:src="@drawable/ic_launcher_calculator"
                    app:shapeAppearance="@style/Rounded12ShapeStyle" />
                <TextView
                    android:textSize="13.0sp"
                    android:textColor="#ff333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dip"
                    android:text="@string/calculator_app_name" />
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="14.0sp"
            android:textColor="#ff666666"
            android:gravity="center_horizontal"
            android:id="@id/tv_incognito_intro_desc"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24.0dip"
            android:layout_marginTop="32.0dip"
            android:layout_marginRight="24.0dip"
            android:text="@string/incognito_mode_intro_desc"
            android:lineSpacingExtra="4.0dip"
            android:layout_marginHorizontal="24.0dip"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_incognito_transform" />
        <TextView
            android:textSize="16.0sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@id/btn_incognito_enable"
            android:background="@drawable/bg_incognito_btn_primary"
            android:layout_width="fill_parent"
            android:layout_height="48.0dip"
            android:layout_marginLeft="32.0dip"
            android:layout_marginRight="32.0dip"
            android:layout_marginBottom="32.0dip"
            android:text="@string/incognito_mode_enable"
            android:layout_marginHorizontal="32.0dip"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/layout_incognito_manage"
        android:paddingLeft="16.0dip"
        android:paddingRight="16.0dip"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginTop="@dimen/add_title_height"
        android:paddingHorizontal="16.0dip">
        <ImageView
            android:id="@id/iv_incognito_shield"
            android:layout_width="92.0dip"
            android:layout_height="92.0dip"
            android:layout_marginTop="64.0dip"
            android:src="@drawable/ic_incognito_shield"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <TextView
            android:textSize="19.0sp"
            android:textColor="#ff333333"
            android:gravity="center_horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16.0dip"
            android:text="@string/incognito_mode_active"
            app:layout_constraintTop_toBottomOf="@id/iv_incognito_shield" />
        <TextView
            android:textSize="16.0sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@id/btn_incognito_disable"
            android:background="@drawable/bg_incognito_btn_primary"
            android:layout_width="fill_parent"
            android:layout_height="48.0dip"
            android:layout_marginLeft="16.0dip"
            android:layout_marginRight="16.0dip"
            android:layout_marginBottom="12.0dip"
            android:text="@string/incognito_mode_disable"
            android:layout_marginHorizontal="16.0dip"
            app:layout_constraintBottom_toTopOf="@id/btn_incognito_change_pwd" />
        <TextView
            android:textSize="16.0sp"
            android:textStyle="bold"
            android:textColor="@color/incognito_accent"
            android:gravity="center"
            android:id="@id/btn_incognito_change_pwd"
            android:background="@drawable/bg_incognito_btn_outline"
            android:layout_width="fill_parent"
            android:layout_height="48.0dip"
            android:layout_marginLeft="16.0dip"
            android:layout_marginRight="16.0dip"
            android:layout_marginBottom="32.0dip"
            android:text="@string/incognito_mode_change_password"
            android:layout_marginHorizontal="16.0dip"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>