<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@android:color/white"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/title"
        android:background="@color/incognito_title_bg"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/add_title_height">
        <ImageView
            android:id="@id/iv_back"
            android:background="@null"
            android:paddingLeft="@dimen/add_back_padding_left"
            android:paddingRight="32.0dip"
            android:layout_width="68.0dip"
            android:layout_height="fill_parent"
            android:src="@drawable/button_back"
            android:scaleType="fitCenter"
            android:layout_centerVertical="true" />
        <TextView
            android:textSize="@dimen/add_list_title_text_size"
            android:textColor="@color/incognito_title_text"
            android:id="@id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@id/iv_back"
            android:layout_centerVertical="true" />
    </RelativeLayout>
    <TextView
        android:textSize="17.0sp"
        android:textStyle="bold"
        android:textColor="#ff1a2744"
        android:gravity="center"
        android:id="@id/tv_incognito_password_hint"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="72.0dip"
        android:text="@string/incognito_password_hint" />
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28.0dip">
        <TextView
            android:id="@id/tv_pin_0"
            style="@style/IncognitoPinBox" />
        <TextView
            android:id="@id/tv_pin_1"
            android:layout_marginLeft="12.0dip"
            android:layout_marginStart="12.0dip"
            style="@style/IncognitoPinBox" />
        <TextView
            android:id="@id/tv_pin_2"
            android:layout_marginLeft="12.0dip"
            android:layout_marginStart="12.0dip"
            style="@style/IncognitoPinBox" />
        <TextView
            android:id="@id/tv_pin_3"
            android:layout_marginLeft="12.0dip"
            android:layout_marginStart="12.0dip"
            style="@style/IncognitoPinBox" />
    </LinearLayout>
    <TextView
        android:textSize="14.0sp"
        android:textColor="#ffe53935"
        android:gravity="center"
        android:id="@id/tv_incognito_password_error"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16.0dip"
        android:text="@string/incognito_password_wrong" />
    <EditText
        android:textColor="@android:color/transparent"
        android:id="@id/et_incognito_pin"
        android:background="@null"
        android:layout_width="1.0dip"
        android:layout_height="1.0dip"
        android:layout_marginTop="8.0dip"
        android:cursorVisible="false"
        android:maxLength="4"
        android:inputType="numberPassword" />
</LinearLayout>