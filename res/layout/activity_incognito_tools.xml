<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@android:color/white"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/title"
        android:background="@color/incognito_title_bg"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/add_title_height">
        <ImageView
            android:id="@id/iv_back"
            android:background="@null"
            android:paddingLeft="@dimen/add_back_padding_left"
            android:paddingRight="32.0dip"
            android:layout_width="68.0dip"
            android:layout_height="fill_parent"
            android:src="@drawable/button_back"
            android:scaleType="fitCenter"
            android:layout_centerVertical="true" />
        <TextView
            android:textSize="@dimen/add_list_title_text_size"
            android:textColor="@color/incognito_title_text"
            android:id="@id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/incognito_tools_title"
            android:layout_toRightOf="@id/iv_back"
            android:layout_centerVertical="true" />
    </RelativeLayout>
    <TextView
        android:textSize="18.0sp"
        android:textStyle="bold"
        android:textColor="#ff1a2744"
        android:id="@id/tv_tools_section"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16.0dip"
        android:layout_marginTop="20.0dip"
        android:layout_marginRight="16.0dip"
        android:text="@string/incognito_tools_section"
        android:layout_marginStart="16.0dip"
        android:layout_marginEnd="16.0dip" />
    <RelativeLayout
        android:id="@id/rl_tools_incognito"
        android:background="@drawable/bg_incognito_tools_card"
        android:paddingLeft="14.0dip"
        android:paddingRight="14.0dip"
        android:layout_width="fill_parent"
        android:layout_height="64.0dip"
        android:layout_marginLeft="16.0dip"
        android:layout_marginTop="12.0dip"
        android:layout_marginRight="16.0dip"
        android:paddingStart="14.0dip"
        android:paddingEnd="14.0dip"
        android:layout_marginStart="16.0dip"
        android:layout_marginEnd="16.0dip">
        <ImageView
            android:id="@id/iv_tools_incognito_icon"
            android:layout_width="40.0dip"
            android:layout_height="40.0dip"
            android:src="@drawable/ic_launcher_calculator"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true" />
        <TextView
            android:textSize="16.0sp"
            android:textColor="#ff333333"
            android:id="@id/tv_tools_incognito_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12.0dip"
            android:text="@string/incognito_mode_title"
            android:layout_toRightOf="@id/iv_tools_incognito_icon"
            android:layout_centerVertical="true"
            android:layout_marginStart="12.0dip"
            android:layout_toEndOf="@id/iv_tools_incognito_icon" />
        <TextView
            android:textSize="9.0sp"
            android:textColor="@color/incognito_enabled_badge_text"
            android:id="@id/tv_tools_incognito_enabled"
            android:background="@drawable/bg_incognito_enabled_badge"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/incognito_mode_enabled_badge"
            android:layout_centerVertical="true"
            android:layout_marginEnd="4.0dip"
            android:layout_toStartOf="@id/iv_more" />
        <ImageView
            android:id="@id/iv_more"
            android:layout_width="12.0dip"
            android:layout_height="12.0dip"
            android:src="@drawable/item_arrow"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>
</LinearLayout>