<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <RelativeLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@color/add_title_bg"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/add_title_height">
            <ImageView
                android:id="@id/iv_back"
                android:paddingLeft="@dimen/add_back_padding_left"
                android:paddingTop="5.0dip"
                android:paddingRight="@dimen/add_back_padding_left"
                android:paddingBottom="5.0dip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/button_back"
                android:layout_centerVertical="true" />
            <TextView
                android:textSize="@dimen/add_list_title_text_size"
                android:textColor="@color/text_color_white"
                android:gravity="center_vertical"
                android:id="@id/title"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:text="@string/information_detail"
                android:layout_centerInParent="true" />
            <ImageView
                android:id="@id/iv_go_feed"
                android:padding="12.0dip"
                android:layout_width="50.0dip"
                android:layout_height="50.0dip"
                android:src="@drawable/icon_feed_back"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true" />
        </RelativeLayout>
        <FrameLayout
            android:background="@color/info_center_bg"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <ScrollView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent">
                    <TextView
                        android:textSize="18.0sp"
                        android:textColor="#ff222222"
                        android:id="@id/tv_message_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16.0dip"
                        android:layout_marginTop="24.0dip"
                        android:layout_marginRight="16.0dip"
                        android:text="RE: 我是用户反馈摘要XXXXXX" />
                    <TextView
                        android:textSize="16.0sp"
                        android:textColor="#ff666666"
                        android:id="@id/tv_message_content"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16.0dip"
                        android:layout_marginTop="18.0dip"
                        android:layout_marginRight="16.0dip"
                        android:text="" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>
</RelativeLayout>