<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <RelativeLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/top"
            android:background="@color/add_title_bg"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/add_title_height">
            <ImageView
                android:id="@id/iv_back"
                android:paddingLeft="@dimen/add_back_padding_left"
                android:paddingTop="5.0dip"
                android:paddingRight="@dimen/add_back_padding_left"
                android:paddingBottom="5.0dip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/button_back"
                android:layout_centerVertical="true" />
            <TextView
                android:textSize="@dimen/add_list_title_text_size"
                android:textColor="@color/text_color_white"
                android:gravity="center_vertical"
                android:id="@id/title"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:text="@string/information_center"
                android:layout_centerInParent="true" />
            <FrameLayout
                android:id="@id/fl_switch"
                android:visibility="visible"
                android:layout_width="50.0dip"
                android:layout_height="fill_parent"
                android:layout_alignParentRight="true">
                <ImageView
                    android:layout_gravity="center|right"
                    android:id="@id/iv_edit"
                    android:layout_width="25.0dip"
                    android:layout_height="25.0dip"
                    android:layout_marginRight="14.0dip"
                    android:src="@drawable/user_setting" />
                <TextView
                    android:textSize="14.0sp"
                    android:textColor="@color/user_edit_color"
                    android:layout_gravity="center|right"
                    android:id="@id/tv_cancel"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="14.0dip"
                    android:text="@string/cancel_information" />
            </FrameLayout>
        </RelativeLayout>
        <FrameLayout
            android:id="@id/fl_content"
            android:background="@color/info_center_bg"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@id/ll_no_info"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/no_infomation_bg" />
                <TextView
                    android:textSize="16.0sp"
                    android:textColor="@color/no_infos"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@id/tv_no_info"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/current_no_informations" />
            </LinearLayout>
            <ScrollView
                android:id="@id/sl_view"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <com.excelliance.kxqp.widget.CustomListView
                        android:id="@id/lv_info"
                        android:focusable="true"
                        android:scrollbars="none"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:layout_marginLeft="-40.0dip"
                        android:listSelector="#00000000"
                        android:cacheColorHint="#00000000"
                        android:divider="@null" />
                    <View
                        android:layout_width="fill_parent"
                        android:layout_height="45.0dip" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>
    <RelativeLayout
        android:id="@id/rl_bottom_bar"
        android:background="@color/notice_center_bottom_bar"
        android:layout_width="fill_parent"
        android:layout_height="45.0dip"
        android:layout_marginBottom="-45.0dip"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="14.0sp"
            android:textColor="@color/notice_center_bottom_read"
            android:id="@id/tv_has_read"
            android:layout_width="80.0dip"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10.0dip"
            android:text="@string/all_has_read"
            android:layout_centerVertical="true" />
        <TextView
            android:textSize="14.0sp"
            android:textColor="@color/notice_center_bottom_delete_gray"
            android:gravity="right"
            android:id="@id/tv_delete"
            android:padding="8.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10.0dip"
            android:text="@string/infomation_delete"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true" />
    </RelativeLayout>
</RelativeLayout>