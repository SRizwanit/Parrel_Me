<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/rootView"
    android:background="#ffffffff"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        android:id="@id/titleView"
        layout="@layout/layout_title_view" />
    <ImageView
        android:id="@id/iv_back1"
        android:padding="5.0dip"
        android:visibility="gone"
        android:layout_width="24.0dip"
        android:layout_height="24.0dip"
        android:layout_marginTop="16.0dip"
        android:src="@drawable/white_cross"
        android:layout_marginEnd="13.0dip"
        android:layout_alignParentEnd="true" />
    <ScrollView
        android:scrollbars="none"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_above="@id/btn_pay"
        android:layout_below="@id/titleView"
        android:overScrollMode="never">
        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@id/iv_pay_banner"
                android:layout_width="fill_parent"
                android:layout_height="140.0dip"
                android:src="@drawable/pay_banner"
                android:scaleType="centerCrop" />
            <RelativeLayout
                android:id="@id/rl_head"
                android:background="@drawable/bg_dialog_pay_head_view"
                android:paddingTop="10.0dip"
                android:paddingBottom="10.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14.0dip"
                android:layout_marginTop="12.0dip"
                android:layout_marginRight="14.0dip"
                android:layout_below="@id/iv_pay_banner">
                <ImageView
                    android:id="@id/iv_head"
                    android:layout_width="46.0dip"
                    android:layout_height="46.0dip"
                    android:layout_marginLeft="16.0dip"
                    android:src="@drawable/head_not_login"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="16.0dip" />
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@id/iv_head"
                    android:layout_alignTop="@id/iv_head"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/iv_head">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@id/ll_nickname"
                        android:paddingBottom="3.0dip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15.0dip"
                        android:layout_marginStart="15.0dip">
                        <TextView
                            android:textSize="18.0sp"
                            android:textColor="#ff333333"
                            android:id="@id/tv_nickname"
                            android:paddingRight="8.0dip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/nickname"
                            android:paddingEnd="8.0dip" />
                        <ImageView
                            android:id="@id/iv_vip_sign"
                            android:layout_width="20.0dip"
                            android:layout_height="20.0dip"
                            android:layout_marginTop="2.0dip"
                            android:src="@drawable/crown_vip" />
                    </LinearLayout>
                    <TextView
                        android:textSize="14.0sp"
                        android:textColor="#ff666666"
                        android:id="@id/tv_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15.0dip"
                        android:text="@string/status_no_vip"
                        android:layout_marginStart="15.0dip" />
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@id/rl_function"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17.0dip"
                android:layout_below="@id/rl_head">
                <TextView
                    android:textSize="16.0sp"
                    android:textColor="@color/add_title_bg"
                    android:id="@id/tv_more"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pay_function_more"
                    android:layout_marginEnd="12.0dip"
                    android:layout_alignParentEnd="true" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@id/ll_function"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10.0dip"
                    android:layout_below="@id/tv_more">
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:id="@id/ll_more_multi"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="7.0dip"
                        android:layout_weight="1.0">
                        <ImageView
                            android:layout_width="40.0dip"
                            android:layout_height="40.0dip"
                            android:src="@drawable/icon_more_multi" />
                        <TextView
                            android:textSize="12.0sp"
                            android:textColor="#ff333333"
                            android:gravity="center_horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8.0dip"
                            android:text="@string/pay_nav_feature0_title" />
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:id="@id/ll_private"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0">
                        <ImageView
                            android:id="@id/iv_private"
                            android:layout_width="40.0dip"
                            android:layout_height="40.0dip"
                            android:src="@drawable/icon_private" />
                        <TextView
                            android:textSize="12.0sp"
                            android:textColor="#ff333333"
                            android:gravity="center_horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8.0dip"
                            android:text="@string/pay_nav_feature3_title" />
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:id="@id/ll_vip_lock"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="7.0dip"
                        android:layout_weight="1.0">
                        <ImageView
                            android:id="@id/iv_vip_lock"
                            android:layout_width="40.0dip"
                            android:layout_height="40.0dip"
                            android:src="@drawable/icon_vip_lock" />
                        <TextView
                            android:textSize="12.0sp"
                            android:textColor="#ff333333"
                            android:gravity="center_horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8.0dip"
                            android:text="@string/pay_nav_feature2_title" />
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:id="@id/ll_no_ad"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0">
                        <ImageView
                            android:id="@id/iv_no_ad"
                            android:layout_width="40.0dip"
                            android:layout_height="40.0dip"
                            android:src="@drawable/icon_no_ad" />
                        <TextView
                            android:textSize="12.0sp"
                            android:textColor="#ff333333"
                            android:gravity="center_horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8.0dip"
                            android:text="@string/pay_nav_feature1_title" />
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/ll_pay_card"
                android:layout_width="fill_parent"
                android:layout_height="105.0dip"
                android:layout_marginLeft="16.669983dip"
                android:layout_marginTop="16.669983dip"
                android:layout_marginRight="16.669983dip"
                android:layout_marginBottom="16.669983dip"
                android:layout_below="@id/rl_function">
                <RelativeLayout
                    android:id="@id/rl_month_pay"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:layout_weight="1.0">
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:id="@id/ll_month_pay"
                        android:background="@drawable/bg_dialog_price_card"
                        android:layout_width="fill_parent"
                        android:layout_height="98.0dip"
                        android:layout_alignParentBottom="true">
                        <com.excelliance.kxqp.ui.view.AlwaysMarqueeTextView
                            android:enabled="false"
                            android:textSize="16.0sp"
                            android:textColor="@drawable/selector_pay_dialog_text"
                            android:id="@id/tv_content_month"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12.0dip"
                            android:text="@string/month"
                            style="@style/style_single_auto_scroll_text_for_all" />
                        <com.excelliance.kxqp.ui.view.AlwaysMarqueeTextView
                            android:textSize="16.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/add_title_bg"
                            android:id="@id/tv_price_month"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8.0dip"
                            android:text="@string/default_price"
                            style="@style/style_single_auto_scroll_text" />
                        <com.excelliance.kxqp.ui.view.AlwaysMarqueeTextView
                            android:textSize="10.0sp"
                            android:textColor="#ff999999"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5.0dip"
                            android:text="@string/monthly_description"
                            style="@style/style_single_auto_scroll_text" />
                    </LinearLayout>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@id/rl_quarter_pay"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:layout_marginLeft="8.329987dip"
                    android:layout_weight="1.0"
                    android:layout_marginStart="8.329987dip">
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:id="@id/ll_quarter_pay"
                        android:background="@drawable/bg_dialog_price_card"
                        android:layout_width="fill_parent"
                        android:layout_height="98.0dip"
                        android:layout_alignParentBottom="true">
                        <com.excelliance.kxqp.ui.view.AlwaysMarqueeTextView
                            android:enabled="true"
                            android:textSize="16.0sp"
                            android:textColor="@drawable/selector_pay_dialog_text"
                            android:id="@id/tv_content_quarter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12.0dip"
                            android:text="@string/quarter"
                            style="@style/style_single_auto_scroll_text_for_all" />
                        <com.excelliance.kxqp.ui.view.AlwaysMarqueeTextView
                            android:textSize="16.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/add_title_bg"
                            android:gravity="center"
                            android:id="@id/tv_price_quarter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8.0dip"
                            android:text="@string/default_price"
                            style="@style/style_single_auto_scroll_text" />
                        <com.excelliance.kxqp.ui.view.AlwaysMarqueeTextView
                            android:textSize="12.0sp"
                            android:textColor="#ff999999"
                            android:gravity="center"
                            android:id="@id/tv_price_quarter_origin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5.0dip"
                            android:text="@string/quarterly_description"
                            style="@style/style_single_auto_scroll_text" />
                    </LinearLayout>
                    <TextView
                        android:textSize="12.0sp"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:id="@id/tv_quarter_discount"
                        android:background="@drawable/discount_sign_pay_card"
                        android:layout_width="70.0dip"
                        android:layout_height="16.0dip"
                        android:text="@string/discount_percentage2" />
                </RelativeLayout>
                <RelativeLayout
                    android:id="@id/rl_annual_pay"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:layout_marginLeft="8.329987dip"
                    android:layout_weight="1.0"
                    android:layout_marginStart="8.329987dip">
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:id="@id/ll_annual_pay"
                        android:background="@drawable/bg_dialog_price_card"
                        android:layout_width="fill_parent"
                        android:layout_height="98.0dip"
                        android:layout_alignParentBottom="true">
                        <com.excelliance.kxqp.ui.view.AlwaysMarqueeTextView
                            android:enabled="true"
                            android:textSize="16.0sp"
                            android:textColor="@drawable/selector_pay_dialog_text"
                            android:id="@id/tv_content_annual"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12.0dip"
                            android:text="@string/annual"
                            style="@style/style_single_auto_scroll_text_for_all" />
                        <com.excelliance.kxqp.ui.view.AlwaysMarqueeTextView
                            android:textSize="16.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/add_title_bg"
                            android:gravity="center"
                            android:id="@id/tv_price_annual"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8.0dip"
                            android:text="@string/default_price"
                            style="@style/style_single_auto_scroll_text" />
                        <com.excelliance.kxqp.ui.view.AlwaysMarqueeTextView
                            android:textSize="12.0sp"
                            android:textColor="#ff999999"
                            android:gravity="center"
                            android:id="@id/tv_price_annual_origin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5.0dip"
                            android:text="@string/yearly_description"
                            style="@style/style_single_auto_scroll_text" />
                    </LinearLayout>
                    <TextView
                        android:textSize="12.0sp"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:id="@id/tv_annual_discount"
                        android:background="@drawable/discount_sign_pay_card"
                        android:layout_width="70.0dip"
                        android:layout_height="16.0dip"
                        android:text="@string/discount_percentage2" />
                </RelativeLayout>
            </LinearLayout>
        </RelativeLayout>
    </ScrollView>
    <ImageView
        android:id="@id/iv_question"
        android:layout_width="18.0dip"
        android:layout_height="18.0dip"
        android:layout_marginBottom="12.0dip"
        android:src="@drawable/question"
        android:layout_alignBottom="@id/tv_bottom_hint"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="18.0dip"
        android:layout_alignParentEnd="true" />
    <TextView
        android:textSize="@dimen/dp_10"
        android:textColor="#ff666666"
        android:id="@id/tv_bottom_hint"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12.0dip"
        android:text="@string/new_pay_bottom_hint1"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="18.0dip"
        android:layout_marginEnd="10.0dip"
        android:layout_toStartOf="@id/iv_question" />
    <Button
        android:textSize="16.0sp"
        android:textColor="#ffffffff"
        android:id="@id/btn_pay"
        android:background="@drawable/bg_new_pay_btn"
        android:layout_width="fill_parent"
        android:layout_height="42.0dip"
        android:layout_marginLeft="30.0dip"
        android:layout_marginRight="30.0dip"
        android:layout_marginBottom="19.0dip"
        android:text="@string/new_pay_start_billing_btn"
        android:layout_above="@id/tv_bottom_hint"
        android:layout_centerHorizontal="true" />
</RelativeLayout>