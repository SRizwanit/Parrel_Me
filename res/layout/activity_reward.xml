                android:background="@drawable/bg_reward_exchange_area"
                android:paddingTop="8.0dip"
                android:paddingBottom="8.0dip"
                android:scrollbars="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10.0dip"
                android:fadeScrollbars="false"
                android:overScrollMode="never"
                android:layout_marginStart="16.669983dip"
                android:layout_marginEnd="16.669983dip" />
        </LinearLayout>
    </ScrollView>
    <Button
        android:textSize="14.0sp"
        android:textColor="#ffffffff"
        android:id="@id/btn_receive"
        android:background="@drawable/bg_google_account_logout"
        android:layout_width="fill_parent"
        android:layout_height="42.0dip"
        android:layout_marginBottom="30.0dip"
        android:text="@string/reward_redeem"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="30.0dip"
        android:layout_marginEnd="30.0dip" />
</RelativeLayout>