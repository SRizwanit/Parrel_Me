                android:background="@drawable/bg_round_gray_4dp"
                android:paddingTop="16.0dip"
                android:paddingBottom="16.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10.0dip"
                android:layout_marginStart="16.669983dip"
                android:layout_marginEnd="16.669983dip">
                <TextView
                    android:textSize="14.0sp"
                    android:textStyle="bold"
                    android:textColor="#ff333333"
                    android:id="@id/tv_function_des"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vip_function_des1" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@id/ll_function_icon"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20.0dip"
                    android:layout_marginStart="7.0dip"
                    android:layout_marginEnd="7.0dip">
                    <ImageView
                        android:id="@id/iv_more_multi"
                        android:layout_width="40.0dip"
                        android:layout_height="40.0dip"
                        android:src="@drawable/icon_more_multi"
                        android:layout_weight="1.0" />
                    <ImageView
                        android:id="@id/iv_private"
                        android:layout_width="40.0dip"
                        android:layout_height="40.0dip"
                        android:src="@drawable/icon_private"
                        android:layout_weight="1.0" />
                    <ImageView
                        android:id="@id/iv_vip_lock"
                        android:layout_width="40.0dip"
                        android:layout_height="40.0dip"
                        android:src="@drawable/icon_vip_lock"
                        android:layout_weight="1.0" />
                    <ImageView
                        android:id="@id/iv_no_ad"
                        android:layout_width="40.0dip"
                        android:layout_height="40.0dip"
                        android:src="@drawable/icon_no_ad"
                        android:layout_weight="1.0" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/ll_function_content"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dip"
                    android:layout_marginStart="7.0dip"
                    android:layout_marginEnd="7.0dip">
                    <TextView
                        android:textSize="12.0sp"
                        android:textColor="#ff333333"
                        android:gravity="center_horizontal"
                        android:id="@id/tv_more_multi"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/pay_nav_feature0_title"
                        android:layout_weight="1.0" />
                    <TextView
                        android:textSize="12.0sp"
                        android:textColor="#ff333333"
                        android:gravity="center_horizontal"
                        android:id="@id/tv_private"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/priv_sz"
                        android:layout_weight="1.0" />
                    <TextView
                        android:textSize="12.0sp"
                        android:textColor="#ff333333"
                        android:gravity="center_horizontal"
                        android:id="@id/tv_vip_lock"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/security_lock"
                        android:layout_weight="1.0" />
                    <TextView
                        android:textSize="12.0sp"
                        android:textColor="#ff333333"
                        android:gravity="center_horizontal"
                        android:id="@id/tv_no_ad"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/pay_nav_feature1_title"
                        android:layout_weight="1.0" />
                </LinearLayout>
            </LinearLayout>
            <TextView
