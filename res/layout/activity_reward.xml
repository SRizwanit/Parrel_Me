                        android:textColor="#ff666666"
                        android:gravity="center_horizontal"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/reward_watched"
                        android:layout_weight="1.0" />
                    <TextView
                        android:textColor="#ff666666"
                        android:gravity="center_horizontal"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
