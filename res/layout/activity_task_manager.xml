<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:background="@color/task_manager_bg"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        android:id="@id/title"
        layout="@layout/layout_title_view" />
    <Button
        android:id="@id/task_clean"
        android:background="@drawable/task_task_clean"
        android:layout_width="24.0dip"
        android:layout_height="24.0dip"
        android:layout_marginTop="16.0dip"
        android:layout_marginRight="16.0dip"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="16.0dip"
        android:layout_alignParentEnd="true" />
    <RelativeLayout
        android:id="@id/content_layout"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginTop="15.0dip"
        android:layout_below="@id/title">
        <RelativeLayout
            android:id="@id/top_content"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.excelliance.kxqp.ui.TaskManagerProgress
                android:id="@id/task_progressbar"
                android:padding="16.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content" />
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20.0dip"
                android:layout_below="@id/task_progressbar">
                <com.excelliance.kxqp.ui.TaskManagerRelativeLayout
                    android:id="@id/my_task_layout"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0" />
                <com.excelliance.kxqp.ui.TaskManagerRelativeLayout
                    android:id="@id/os_task_layout"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0" />
                <com.excelliance.kxqp.ui.TaskManagerRelativeLayout
                    android:id="@id/last_task_layout"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0" />
            </LinearLayout>
        </RelativeLayout>
        <View
            android:id="@id/task_line"
            android:background="#ffffffff"
            android:layout_width="fill_parent"
            android:layout_height="1.0dip"
            android:layout_marginTop="16.0dip"
            android:layout_marginBottom="8.0dip"
            android:layout_below="@id/top_content" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@id/task_content_list"
            android:background="@color/memory_task_listview_color"
            android:scrollbars="none"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:cacheColorHint="@color/memory_task_listview_color"
            android:divider="@null"
            android:layout_below="@id/task_line" />
    </RelativeLayout>
    <RelativeLayout
        android:id="@id/progress_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateDrawable="@drawable/progress_animal"
            style="?android:progressBarStyle" />
    </RelativeLayout>
</RelativeLayout>