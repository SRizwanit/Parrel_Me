<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@null"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/game_item_header2_layout"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@id/list_header_divider2_up"
            android:background="@color/add_game_item_color"
            android:layout_width="fill_parent"
            android:layout_height="1.0px" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/game_item_header2_ll"
            android:background="@color/add_game_item_color"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/add_list_header_height">
            <TextView
                android:textSize="16.0dip"
                android:textColor="@color/add_game_app_color"
                android:gravity="center_vertical"
                android:id="@id/game_item_header2"
                android:paddingLeft="@dimen/add_list_padding_edge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:paddingStart="@dimen/add_list_padding_edge" />
        </LinearLayout>
        <View
            android:id="@id/list_header2_divider"
            android:background="@color/list_divider_color"
            android:layout_width="fill_parent"
            android:layout_height="0.0px" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/game_item_header_layout"
        android:background="@color/add_game_item_color"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@id/list_header_divider_up"
            android:background="@color/list_divider_color"
            android:layout_width="fill_parent"
            android:layout_height="0.0px" />
        <TextView
            android:textSize="16.0dip"
            android:textColor="@color/add_game_app_color"
            android:gravity="center_vertical"
            android:layout_gravity="start"
            android:id="@id/game_item_header"
            android:paddingLeft="@dimen/add_list_padding_edge"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/add_list_header_height"
            android:singleLine="true"
            android:paddingStart="@dimen/add_list_padding_edge" />
        <View
            android:id="@id/list_header_divider"
            android:background="@color/list_divider_color"
            android:layout_width="fill_parent"
            android:layout_height="0.0px" />
    </LinearLayout>
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@id/game_item_ll"
        android:background="@color/color_eef1f6"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/add_list_item_height">
        <com.excelliance.kxqp.ui.view.RecycleImageView
            android:id="@id/add_game_iv"
            android:layout_width="@dimen/add_list_icon_width"
            android:layout_height="@dimen/add_list_icon_width"
            android:layout_marginLeft="@dimen/add_list_padding_edge"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/add_list_padding_edge"
            android:layout_alignParentStart="true" />
        <RelativeLayout
            android:id="@id/add_game_btn_layout"
            android:background="@drawable/add_btn_bg"
            android:layout_width="wrap_content"
            android:layout_height="26.0dip"
            android:layout_marginRight="20.0dip"
            android:minWidth="46.0dip"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="20.0dip"
            android:layout_alignParentEnd="true">
            <TextView
                android:textSize="16.0sp"
                android:textColor="@color/add_title_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add"
                android:layout_centerInParent="true"
                android:paddingStart="5.0dip"
                android:paddingEnd="5.0dip" />
            <ImageButton
                android:id="@id/add_game_btn"
                android:visibility="gone"
                android:layout_width="@dimen/add_list_add_width"
                android:layout_height="@dimen/add_list_add_width"
                android:layout_marginRight="@dimen/add_list_padding_edge"
                android:scaleType="fitCenter"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/add_list_padding_edge"
                android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/add_list_name_text_size"
            android:textColor="@color/add_game_app_color"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@id/add_game_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/add_list_name_margin_left"
            android:layout_marginRight="8.0dip"
            android:maxWidth="200.0dip"
            android:singleLine="true"
            android:layout_toRightOf="@id/add_game_iv"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/add_list_name_margin_left"
            android:layout_marginEnd="8.0dip"
            android:layout_toEndOf="@id/add_game_iv" />
    </RelativeLayout>
    <View
        android:id="@id/list_divider"
        android:background="@color/list_divider_color"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_marginLeft="@dimen/add_list_name_margin_left"
        android:layout_marginStart="@dimen/add_list_name_margin_left" />
</LinearLayout>