<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/primary_fg_color"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/game_item_header2_layout"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@id/list_header_divider2_up"
            android:background="@color/list_divider_color"
            android:layout_width="fill_parent"
            android:layout_height="1.0px" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/game_item_header2_ll"
            android:background="#ffececec"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/add_list_header_height">
            <TextView
                android:textSize="16.0dip"
                android:textColor="@color/add_header_text_color"
                android:gravity="center_vertical"
                android:id="@id/game_item_header2"
                android:paddingLeft="@dimen/add_list_padding_edge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true" />
        </LinearLayout>
        <View
            android:id="@id/list_header2_divider"
            android:background="@color/list_divider_color"
            android:layout_width="fill_parent"
            android:layout_height="1.0px" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/game_item_header_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@id/list_header_divider_up"
            android:background="@color/list_divider_color"
            android:layout_width="fill_parent"
            android:layout_height="1.0px" />
        <TextView
            android:textSize="16.0dip"
            android:textColor="@color/add_header_text_color"
            android:gravity="center_vertical"
            android:id="@id/game_item_header"
            android:background="#ffececec"
            android:paddingLeft="@dimen/add_list_padding_edge"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/add_list_header_height"
            android:singleLine="true" />
        <View
            android:id="@id/list_header_divider"
            android:background="@color/list_divider_color"
            android:layout_width="fill_parent"
            android:layout_height="1.0px" />
    </LinearLayout>
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@id/game_item_ll"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/add_list_item_height">
        <ImageView
            android:id="@id/add_game_iv"
            android:layout_width="@dimen/add_list_icon_width"
            android:layout_height="@dimen/add_list_icon_width"
            android:layout_marginLeft="@dimen/add_list_padding_edge"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true" />
        <RelativeLayout
            android:id="@id/add_game_btn_layout"
            android:layout_width="40.0dip"
            android:layout_height="fill_parent"
            android:layout_alignParentRight="true">
            <CheckBox
                android:gravity="center"
                android:id="@id/add_game_btn"
                android:layout_width="@dimen/add_list_add_width"
                android:layout_height="@dimen/add_list_add_width"
                android:layout_marginRight="@dimen/add_list_padding_edge"
                android:checked="false"
                android:scaleType="fitCenter"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true" />
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/add_list_name_text_size"
            android:textColor="@color/add_app_name_text_color"
            android:ellipsize="end"
            android:id="@id/add_game_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/add_list_name_margin_left"
            android:layout_marginRight="8.0dip"
            android:singleLine="true"
            android:layout_toLeftOf="@id/add_game_btn_layout"
            android:layout_toRightOf="@id/add_game_iv"
            android:layout_centerVertical="true" />
    </RelativeLayout>
    <View
        android:id="@id/list_divider"
        android:background="@color/list_divider_color"
        android:layout_width="fill_parent"
        android:layout_height="1.0px"
        android:layout_marginLeft="@dimen/add_list_divider_padding_left" />
</LinearLayout>