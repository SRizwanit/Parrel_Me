<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/add_main_layout"
    android:background="#ffffffff"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        android:id="@id/title"
        layout="@layout/layout_title_view" />
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@id/add_game_no_apk_layout"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <TextView
            android:textSize="20.0sp"
            android:textColor="@color/primary_gray_color"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/add_game_no_apk_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_apk" />
    </LinearLayout>
    <RelativeLayout
        android:orientation="vertical"
        android:id="@id/add_game_list_layout"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@id/add_game_rv"
            android:scrollbars="none"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:divider="@null" />
        <com.excelliance.kxqp.ui.view.IndexView
            android:id="@id/index_view"
            android:visibility="gone"
            android:layout_width="25.0dip"
            android:layout_height="fill_parent"
            android:layout_marginTop="20.0dip"
            android:layout_marginBottom="14.0dip"
            android:layout_alignParentEnd="true" />
        <TextView
            android:textSize="20.0sp"
            android:textColor="@color/text_color_white"
            android:gravity="center"
            android:id="@id/tv_letter"
            android:background="@drawable/tv_letter_bg"
            android:visibility="gone"
            android:layout_width="50.0dip"
            android:layout_height="55.0dip"
            android:layout_centerInParent="true" />
    </RelativeLayout>
</LinearLayout>