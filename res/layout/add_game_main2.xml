<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/add_main_layout"
    android:background="@null"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@id/add_game_layout_back2"
        android:background="@color/add_title_bg"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/add_title_height">
        <ImageView
            android:id="@id/iv_back2"
            android:background="@null"
            android:paddingLeft="@dimen/add_back_padding_left"
            android:paddingRight="32.0dip"
            android:layout_width="68.0dip"
            android:layout_height="fill_parent"
            android:scaleType="fitCenter"
            android:layout_centerVertical="true" />
        <TextView
            android:textSize="@dimen/add_list_title_text_size"
            android:textColor="@color/text_color_white"
            android:id="@id/add_game_tv_back2"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_game"
            android:layout_toRightOf="@id/iv_back2"
            android:layout_centerVertical="true" />
    </RelativeLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@id/add_game_no_apk_layout2"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <TextView
            android:textSize="20.0sp"
            android:textColor="@color/primary_gray_color"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/add_game_no_apk_text2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_apk" />
    </LinearLayout>
    <RelativeLayout
        android:orientation="vertical"
        android:id="@id/add_game_list_rlayout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/add_game_list_llayout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <ListView
                android:id="@id/add_game_lv2"
                android:scrollbars="@null"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:divider="@null"
                android:layout_weight="1.0" />
            <View
                android:id="@id/first_start_ok_after"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/first_start_enable_height" />
        </LinearLayout>
        <TextView
            android:textSize="@dimen/first_start_enable_text_size"
            android:textStyle="bold"
            android:textColor="@color/text_color_white"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/first_start_ok2"
            android:background="@color/first_enable_bg"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/first_start_enable_height"
            android:text="@string/add"
            android:maxLines="1"
            android:layout_alignParentBottom="true" />
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <ProgressBar
            android:id="@id/add_game_loading_progressBar2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true" />
    </RelativeLayout>
</LinearLayout>