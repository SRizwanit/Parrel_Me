<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/primary_fg_color"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@id/add_game_no_apk_layout"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <TextView
            android:textSize="20.0sp"
            android:textColor="@color/primary_gray_color"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/add_game_no_apk_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_apk" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/add_game_list_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <ListView
            android:id="@id/add_game_lv"
            android:scrollbars="none"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:divider="@null" />
    </LinearLayout>
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <ProgressBar
            android:id="@id/add_game_loading_progressBar"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true" />
    </RelativeLayout>
</LinearLayout>