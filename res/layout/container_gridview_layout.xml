<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center"
    android:orientation="vertical"
    android:id="@id/root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout
        android:id="@id/item_icon_framelayout"
        android:layout_width="40.0dip"
        android:layout_height="40.0dip"
        android:layout_marginBottom="8.0dip"
        android:layout_centerInParent="true">
        <com.dxt.lyl.mylauncher.view.InnerCellView
            android:layout_gravity="center"
            android:id="@id/inner_cellView"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent" />
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@id/hint_point"
            android:visibility="gone"
            android:layout_width="6.0dip"
            android:layout_height="6.0dip"
            android:layout_marginRight="4.0dip" />
        <TextView
            android:textSize="12.0sp"
            android:textColor="@color/app_text_color_white"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@id/item_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/da_app_name"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>