<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center"
    android:orientation="vertical"
    android:id="@id/custom_dialog_layout01"
    android:layout_width="wrap_content"
    android:layout_height="240.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center|right|top"
        android:layout_gravity="center|right|top"
        android:orientation="horizontal"
        android:id="@id/dialog_title_line"
        android:background="@null"
        android:paddingLeft="20.0dip"
        android:paddingTop="5.0dip"
        android:paddingRight="2.0dip"
        android:paddingBottom="0.0dip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20.0dip"
        android:minHeight="15.0dip"
        android:layout_alignParentTop="true">
        <TextView
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:gravity="top"
            android:layout_gravity="top"
            android:id="@id/dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="" />
        <ImageButton
            android:layout_gravity="center|right|top"
            android:id="@id/cancelButton"
            android:background="@null"
            android:layout_width="20.0dip"
            android:layout_height="20.0dip"
            android:layout_marginLeft="0.0dip"
            android:layout_marginTop="0.0dip"
            android:layout_marginRight="3.0dip"
            android:layout_marginBottom="0.0dip"
            android:scaleType="fitCenter"
            android:text=""
            android:layout_toRightOf="@id/dialog_title"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true" />
    </LinearLayout>
    <TextView
        android:textSize="18.0sp"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:id="@id/dialog_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="7.0dip"
        android:layout_marginTop="3.0dip"
        android:layout_marginRight="7.0dip"
        android:layout_marginBottom="13.0dip"
        android:text="是否花费1元兑换10金果？" />
    <TextView
        android:textSize="14.0sp"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:id="@id/cusomer_service_phone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="3.0dip"
        android:layout_marginTop="3.0dip"
        android:layout_marginRight="3.0dip"
        android:layout_marginBottom="7.0dip"
        android:text="客服电话：+86-21-61912816" />
    <Button
        android:id="@id/OkButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="7.0dip"
        android:text="" />
</LinearLayout>