<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/rootView"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@id/rl_dialog"
        android:background="@drawable/bg_dialog_pay_hint"
        android:paddingBottom="14.0dip"
        android:layout_width="280.0dip"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true">
        <ImageView
            android:id="@id/iv_ad_sign"
            android:layout_width="40.0dip"
            android:layout_height="40.0dip"
            android:src="@drawable/ad_sign" />
        <ImageView
            android:id="@id/iv_logo"
            android:layout_width="60.0dip"
            android:layout_height="60.0dip"
            android:layout_marginTop="15.0dip"
            android:src="@drawable/logo_com_pspace_vandroid"
            android:layout_centerHorizontal="true" />
        <TextView
            android:textSize="14.0sp"
            android:textColor="#ff333333"
            android:id="@id/tv_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24.0dip"
            android:layout_marginTop="12.0dip"
            android:layout_marginRight="24.0dip"
            android:text="@string/dialog_app_guide_content"
            android:layout_below="@id/iv_logo" />
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/ll_button"
            android:layout_width="fill_parent"
            android:layout_height="34.0dip"
            android:layout_marginTop="30.0dip"
            android:layout_below="@id/tv_content"
            android:layout_marginStart="16.0dip"
            android:layout_marginEnd="16.0dip">
            <TextView
                android:textSize="14.0sp"
                android:textColor="@color/dialog_button_left_text_color"
                android:gravity="center"
                android:id="@id/tv_cancel"
                android:background="@drawable/dialog_bt_left_selector"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:text="@string/no"
                android:layout_weight="1.0"
                android:layout_marginEnd="5.0dip" />
            <TextView
                android:textSize="14.0sp"
                android:textColor="@color/dialog_button_right_text_color"
                android:gravity="center"
                android:id="@id/tv_sure"
                android:background="@drawable/dialog_bt_right_selector"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:text="@string/yes"
                android:layout_weight="1.0"
                android:layout_marginStart="5.0dip" />
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>