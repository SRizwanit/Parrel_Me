<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:layout_gravity="center"
        android:background="@drawable/custom_dialog_bg"
        android:layout_width="288.0dip"
        android:layout_height="84.0dip">
        <TextView
            android:textSize="18.0sp"
            android:textColor="@color/nickname"
            android:padding="12.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/user_sex"
            android:layout_centerHorizontal="true" />
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <TextView
                android:textSize="16.0sp"
                android:textColor="@color/sex_man"
                android:gravity="center"
                android:id="@id/tv_man"
                android:background="@drawable/dialog_button_bg_selector"
                android:padding="14.0dip"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:text="@string/person_man"
                android:layout_weight="1.0" />
            <ImageView
                android:gravity="center"
                android:background="@color/myvip_line_inner"
                android:layout_width="1.0dip"
                android:layout_height="15.0dip"
                android:layout_marginTop="17.0dip" />
            <TextView
                android:textSize="16.0sp"
                android:textColor="@color/sex_woman"
                android:gravity="center"
                android:id="@id/tv_woman"
                android:background="@drawable/dialog_button_bg_selector"
                android:padding="14.0dip"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:text="@string/person_woman"
                android:layout_weight="1.0" />
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>