<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/rootView"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/ll_dialog"
        android:background="@drawable/bg_dialog_pay_hint"
        android:paddingBottom="15.0dip"
        android:layout_width="280.0dip"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true">
        <ImageView
            android:id="@id/iv_close"
            android:padding="5.0dip"
            android:layout_width="25.0dip"
            android:layout_height="25.0dip"
            android:layout_marginTop="10.0dip"
            android:layout_marginRight="10.0dip"
            android:src="@drawable/close"
            android:layout_alignParentRight="true" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/ll_more_multi"
            android:paddingLeft="15.0dip"
            android:paddingRight="15.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2.0dip"
            android:layout_below="@id/iv_close">
            <ImageView
                android:layout_width="40.0dip"
                android:layout_height="40.0dip"
                android:src="@drawable/icon_more_multi" />
            <LinearLayout
                android:orientation="vertical"
                android:paddingLeft="18.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16.0sp"
                    android:textColor="#ff333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pay_nav_feature0_title" />
                <TextView
                    android:textSize="14.0sp"
                    android:textColor="#ff666666"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dip"
                    android:text="@string/pay_nav_feature0_content" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/iv_no_ad"
            android:paddingLeft="15.0dip"
            android:paddingRight="15.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="27.0dip"
            android:layout_below="@id/ll_more_multi">
            <ImageView
                android:layout_width="40.0dip"
                android:layout_height="40.0dip"
                android:src="@drawable/icon_no_ad" />
            <LinearLayout
                android:orientation="vertical"
                android:paddingLeft="18.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16.0sp"
                    android:textColor="#ff333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pay_nav_feature1_title" />
                <TextView
                    android:textSize="14.0sp"
                    android:textColor="#ff666666"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dip"
                    android:text="@string/pay_nav_feature1_content" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/ll_private"
            android:paddingLeft="15.0dip"
            android:paddingRight="15.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="27.0dip"
            android:layout_below="@id/iv_no_ad">
            <ImageView
                android:layout_width="40.0dip"
                android:layout_height="40.0dip"
                android:src="@drawable/icon_private" />
            <LinearLayout
                android:orientation="vertical"
                android:paddingLeft="18.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16.0sp"
                    android:textColor="#ff333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pay_nav_feature3_title" />
                <TextView
                    android:textSize="14.0sp"
                    android:textColor="#ff666666"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dip"
                    android:text="@string/pay_nav_feature3_content" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/ll_vip_lock"
            android:paddingLeft="15.0dip"
            android:paddingRight="15.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="27.0dip"
            android:layout_below="@id/ll_private">
            <ImageView
                android:layout_width="40.0dip"
                android:layout_height="40.0dip"
                android:src="@drawable/icon_vip_lock" />
            <LinearLayout
                android:orientation="vertical"
                android:paddingLeft="18.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16.0sp"
                    android:textColor="#ff333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pay_nav_feature2_title" />
                <TextView
                    android:textSize="14.0sp"
                    android:textColor="#ff666666"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dip"
                    android:text="@string/pay_nav_feature2_content" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>