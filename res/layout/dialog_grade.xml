<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/rl_dialog"
        android:background="@drawable/bg_dialog_pay_hint"
        android:paddingTop="@dimen/dp_15"
        android:paddingBottom="@dimen/dp_25"
        android:layout_width="@dimen/dp_290"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true">
        <ImageView
            android:id="@id/iv_head"
            android:layout_width="@dimen/dp_242"
            android:layout_height="@dimen/dp_97"
            android:src="@drawable/bg_dialog_grade_head"
            android:layout_centerHorizontal="true" />
        <TextView
            android:textSize="@dimen/dp_15"
            android:textColor="#ffffffff"
            android:id="@id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_60"
            android:text="@string/dialog_grade_title"
            android:layout_centerHorizontal="true" />
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="#ff333333"
            android:id="@id/tv_content"
            android:paddingLeft="@dimen/dp_25"
            android:paddingRight="@dimen/dp_25"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_28"
            android:text="@string/dialog_grade_content"
            android:layout_below="@id/iv_head"
            android:layout_centerHorizontal="true" />
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/ll_star"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_26"
            android:layout_below="@id/tv_content"
            android:paddingStart="@dimen/dp_30"
            android:paddingEnd="@dimen/dp_30">
            <ImageView
                android:id="@id/iv_star1"
                android:layout_width="@dimen/dp_46"
                android:layout_height="@dimen/dp_26.5"
                android:src="@drawable/star_gray"
                android:paddingStart="@dimen/dp_8.5"
                android:paddingEnd="@dimen/dp_8.5" />
            <ImageView
                android:id="@id/iv_star2"
                android:layout_width="@dimen/dp_46"
                android:layout_height="@dimen/dp_26.5"
                android:src="@drawable/star_gray"
                android:paddingStart="@dimen/dp_8.5"
                android:paddingEnd="@dimen/dp_8.5" />
            <ImageView
                android:id="@id/iv_star3"
                android:layout_width="@dimen/dp_46"
                android:layout_height="@dimen/dp_26.5"
                android:src="@drawable/star_gray"
                android:paddingStart="@dimen/dp_8.5"
                android:paddingEnd="@dimen/dp_8.5" />
            <ImageView
                android:id="@id/iv_star4"
                android:layout_width="@dimen/dp_46"
                android:layout_height="@dimen/dp_26.5"
                android:src="@drawable/star_gray"
                android:paddingStart="@dimen/dp_8.5"
                android:paddingEnd="@dimen/dp_8.5" />
            <ImageView
                android:id="@id/iv_star5"
                android:layout_width="@dimen/dp_46"
                android:layout_height="@dimen/dp_26.5"
                android:src="@drawable/star_gray"
                android:paddingStart="@dimen/dp_8.5"
                android:paddingEnd="@dimen/dp_8.5" />
        </LinearLayout>
        <TextView
            android:enabled="false"
            android:textSize="@dimen/dp_14"
            android:textColor="#ff333333"
            android:gravity="center"
            android:id="@id/tv_grade"
            android:background="@drawable/bg_dialog_grade_grade"
            android:layout_width="@dimen/dp_240"
            android:layout_height="@dimen/dp_34"
            android:layout_marginTop="@dimen/dp_23"
            android:text="@string/dialog_grade_rate_us_now"
            android:layout_below="@id/ll_star"
            android:layout_centerHorizontal="true" />
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@id/tv_feedback"
            android:background="@drawable/bg_dialog_grade_feedback"
            android:visibility="gone"
            android:layout_width="@dimen/dp_240"
            android:layout_height="@dimen/dp_34"
            android:layout_marginTop="@dimen/dp_23"
            android:text="@string/dialog_grade_feedback"
            android:layout_below="@id/ll_star"
            android:layout_centerHorizontal="true" />
    </RelativeLayout>
    <ImageView
        android:id="@id/iv_close"
        android:visibility="invisible"
        android:layout_width="@dimen/dp_30"
        android:layout_height="@dimen/dp_30"
        android:layout_marginTop="@dimen/dp_30"
        android:src="@drawable/close_round"
        android:layout_below="@id/rl_dialog"
        android:layout_centerHorizontal="true" />
</RelativeLayout>