<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/rootView"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/ll_dialog"
        android:background="@drawable/bg_dialog_pay_hint"
        android:layout_width="280.0dip"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true">
        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16.0dip">
            <ImageView
                android:id="@id/iv_crown"
                android:layout_width="wrap_content"
                android:layout_height="33.0dip"
                android:src="@drawable/crown_gold"
                android:scaleType="centerCrop"
                android:layout_centerHorizontal="true" />
            <ImageView
                android:id="@id/iv_free_sign"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="33.0dip"
                android:src="@drawable/free_sign"
                android:scaleType="centerCrop"
                android:layout_centerHorizontal="true" />
        </RelativeLayout>
        <TextView
            android:textSize="14.0sp"
            android:textColor="#ff333333"
            android:gravity="center"
            android:id="@id/tv_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20.0dip"
            android:layout_marginTop="15.0dip"
            android:layout_marginRight="20.0dip"
            android:text="@string/content_pay_dialog_vip"
            android:layout_marginStart="20.0dip"
            android:layout_marginEnd="20.0dip" />
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/rl_function"
            android:paddingTop="24.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="7.0dip"
                android:layout_marginEnd="7.0dip">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@id/ll_more_multi"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0">
                    <ImageView
                        android:layout_width="40.0dip"
                        android:layout_height="40.0dip"
                        android:src="@drawable/icon_more_multi" />
                    <TextView
                        android:textSize="12.0sp"
                        android:textColor="#ff333333"
                        android:gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8.0dip"
                        android:text="@string/pay_nav_feature0_title" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@id/ll_no_ad"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0">
                    <ImageView
                        android:id="@id/iv_no_ad"
                        android:layout_width="40.0dip"
                        android:layout_height="40.0dip"
                        android:src="@drawable/icon_no_ad" />
                    <TextView
                        android:textSize="12.0sp"
                        android:textColor="#ff333333"
                        android:gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8.0dip"
                        android:text="@string/pay_nav_feature1_title" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10.0dip"
                android:layout_marginStart="7.0dip"
                android:layout_marginEnd="7.0dip">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@id/ll_private"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0">
                    <ImageView
                        android:id="@id/iv_private"
                        android:layout_width="40.0dip"
                        android:layout_height="40.0dip"
                        android:src="@drawable/icon_private" />
                    <TextView
                        android:textSize="12.0sp"
                        android:textColor="#ff333333"
                        android:gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8.0dip"
                        android:text="@string/pay_nav_feature3_title" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@id/ll_vip_lock"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0">
                    <ImageView
                        android:id="@id/iv_vip_lock"
                        android:layout_width="40.0dip"
                        android:layout_height="40.0dip"
                        android:src="@drawable/icon_vip_lock" />
                    <TextView
                        android:textSize="12.0sp"
                        android:textColor="#ff333333"
                        android:gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8.0dip"
                        android:text="@string/pay_nav_feature2_title" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@id/iv_process"
            android:visibility="gone"
            android:layout_width="84.0dip"
            android:layout_height="84.0dip"
            android:layout_marginTop="22.0dip"
            android:src="@drawable/price_drawing_process"
            android:scaleType="centerCrop" />
        <TextView
            android:textColor="#ff333333"
            android:gravity="center"
            android:id="@id/tv_hint"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="84.0dip"
            android:layout_marginLeft="20.0dip"
            android:layout_marginTop="22.0dip"
            android:layout_marginRight="20.0dip"
            android:text="@string/launch_billing_fail_hint"
            android:layout_marginStart="20.0dip"
            android:layout_marginEnd="20.0dip" />
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/ll_pay_card"
            android:layout_width="fill_parent"
            android:layout_height="98.0dip"
            android:layout_marginLeft="15.0dip"
            android:layout_marginTop="8.0dip"
            android:layout_marginRight="8.0dip"
            android:layout_marginStart="15.0dip"
            android:layout_marginEnd="8.0dip">
            <RelativeLayout
                android:id="@id/rl_month_pay"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_weight="1.0">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@id/ll_month_pay"
                    android:background="@drawable/bg_dialog_price_card"
                    android:layout_width="fill_parent"
                    android:layout_height="84.0dip"
                    android:layout_marginRight="7.0dip"
                    android:layout_alignParentBottom="true"
                    android:layout_marginEnd="7.0dip">
                    <com.excelliance.kxqp.ui.view.AlwaysMarqueeTextView
                        android:enabled="false"
                        android:textSize="16.0sp"
                        android:textColor="@drawable/selector_pay_dialog_text"
                        android:id="@id/tv_content_month"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9.0dip"
                        android:text="@string/month"
                        style="@style/style_single_auto_scroll_text_for_all" />
                    <com.excelliance.kxqp.ui.view.AlwaysMarqueeTextView
                        android:textSize="14.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/add_title_bg"
                        android:id="@id/tv_price_month"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5.0dip"
                        android:text="@string/default_price"
                        style="@style/style_single_auto_scroll_text" />
                    <com.excelliance.kxqp.ui.view.AlwaysMarqueeTextView
                        android:textSize="8.0sp"
                        android:textColor="#ff999999"
                        android:gravity="center"
                        android:id="@id/tv_description_month"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7.0dip"
                        android:text="@string/monthly_description"
                        style="@style/style_single_auto_scroll_text" />
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@id/rl_quarter_pay"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_weight="1.0">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@id/ll_quarter_pay"
                    android:background="@drawable/bg_dialog_price_card"
                    android:layout_width="fill_parent"
                    android:layout_height="84.0dip"
                    android:layout_marginRight="7.0dip"
                    android:layout_alignParentBottom="true"
                    android:layout_marginEnd="7.0dip">
                    <com.excelliance.kxqp.ui.view.AlwaysMarqueeTextView
                        android:enabled="true"
                        android:textSize="16.0sp"
                        android:textColor="@drawable/selector_pay_dialog_text"
                        android:id="@id/tv_content_quarter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9.0dip"
                        android:text="@string/quarter"
                        style="@style/style_single_auto_scroll_text_for_all" />
                    <com.excelliance.kxqp.ui.view.AlwaysMarqueeTextView
                        android:textSize="14.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/add_title_bg"
                        android:gravity="center"
                        android:id="@id/tv_price_quarter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5.0dip"
                        android:text="@string/default_price"
                        style="@style/style_single_auto_scroll_text" />
                    <com.excelliance.kxqp.ui.view.AlwaysMarqueeTextView
                        android:textSize="8.0sp"
                        android:textColor="#ff999999"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7.0dip"
                        android:text="@string/quarterly_description"
                        style="@style/style_single_auto_scroll_text" />
                </LinearLayout>
                <TextView
                    android:textSize="10.0sp"
                    android:textColor="#ff333333"
                    android:gravity="center"
                    android:id="@id/tv_quarter_discount"
                    android:background="@drawable/discount_sign_pay_dialog"
                    android:layout_width="36.0dip"
                    android:layout_height="36.0dip"
                    android:text="@string/discount_percentage1"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <RelativeLayout
                android:id="@id/rl_annual_pay"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_weight="1.0">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@id/ll_annual_pay"
                    android:background="@drawable/bg_dialog_price_card"
                    android:layout_width="fill_parent"
                    android:layout_height="84.0dip"
                    android:layout_marginRight="7.0dip"
                    android:layout_alignParentBottom="true"
                    android:layout_marginEnd="7.0dip">
                    <com.excelliance.kxqp.ui.view.AlwaysMarqueeTextView
                        android:enabled="true"
                        android:textSize="16.0sp"
                        android:textColor="@drawable/selector_pay_dialog_text"
                        android:id="@id/tv_content_annual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9.0dip"
                        android:text="@string/annual"
                        style="@style/style_single_auto_scroll_text_for_all" />
                    <com.excelliance.kxqp.ui.view.AlwaysMarqueeTextView
                        android:textSize="14.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/add_title_bg"
                        android:gravity="center"
                        android:id="@id/tv_price_annual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6.0dip"
                        android:text="@string/default_price"
                        style="@style/style_single_auto_scroll_text" />
                    <com.excelliance.kxqp.ui.view.AlwaysMarqueeTextView
                        android:textSize="8.0sp"
                        android:textColor="#ff999999"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5.0dip"
                        android:text="@string/yearly_description"
                        style="@style/style_single_auto_scroll_text" />
                </LinearLayout>
                <TextView
                    android:textSize="10.0sp"
                    android:textColor="#ff333333"
                    android:gravity="center"
                    android:id="@id/tv_annual_discount"
                    android:background="@drawable/discount_sign_pay_dialog"
                    android:layout_width="36.0dip"
                    android:layout_height="36.0dip"
                    android:text="@string/discount_percentage1"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentEnd="true" />
            </RelativeLayout>
        </LinearLayout>
        <Button
            android:textSize="14.0sp"
            android:textColor="#ffffffff"
            android:layout_gravity="center_horizontal"
            android:id="@id/btn_pay"
            android:background="@drawable/bg_new_pay_btn"
            android:layout_width="240.0dip"
            android:layout_height="34.0dip"
            android:layout_marginTop="18.0dip"
            android:text="@string/new_pay_start_billing_btn" />
        <TextView
            android:textSize="@dimen/dp_10"
            android:textColor="#ff666666"
            android:id="@id/tv_bottom_hint"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10.0dip"
            android:text="@string/new_pay_bottom_hint1"
            android:layout_marginStart="20.0dip"
            android:layout_marginEnd="20.0dip" />
        <View
            android:id="@id/v_bottom"
            android:layout_width="fill_parent"
            android:layout_height="13.0dip" />
    </LinearLayout>
    <ImageView
        android:id="@id/iv_close"
        android:padding="5.0dip"
        android:layout_width="25.0dip"
        android:layout_height="25.0dip"
        android:layout_marginTop="10.0dip"
        android:layout_marginRight="10.0dip"
        android:src="@drawable/close"
        android:layout_alignRight="@id/ll_dialog"
        android:layout_marginEnd="10.0dip"
        android:layout_alignEnd="@id/ll_dialog" />
</RelativeLayout>