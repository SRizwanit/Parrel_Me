<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/rootView"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/ll_dialog"
        android:background="@drawable/bg_dialog_pay_hint"
        android:paddingBottom="15.0dip"
        android:layout_width="280.0dip"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="16.0sp"
            android:textColor="#ff333333"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="19.0dip"
            android:text="@string/pay_hint_title"
            android:paddingStart="10.0dip"
            android:paddingEnd="10.0dip" />
        <TextView
            android:textSize="12.0sp"
            android:textColor="#ff333333"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20.0dip"
            android:layout_marginTop="22.0dip"
            android:layout_marginRight="20.0dip"
            android:text="@string/pay_hint_content" />
    </LinearLayout>
    <ImageView
        android:id="@id/iv_close"
        android:padding="5.0dip"
        android:layout_width="25.0dip"
        android:layout_height="25.0dip"
        android:layout_marginTop="10.0dip"
        android:src="@drawable/close"
        android:layout_marginEnd="10.0dip"
        android:layout_alignEnd="@id/ll_dialog" />
</RelativeLayout>