<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/rootView"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@id/ll_dialog"
        android:background="@drawable/bg_dialog_pay_hint"
        android:paddingLeft="20.0dip"
        android:paddingTop="19.0dip"
        android:paddingRight="20.0dip"
        android:paddingBottom="15.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="16.0sp"
            android:textStyle="bold"
            android:textColor="#ff333333"
            android:id="@id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_privacy_413_title"
            android:layout_centerHorizontal="true" />
        <TextView
            android:textSize="14.0sp"
            android:textColor="#ff333333"
            android:gravity="center_horizontal"
            android:id="@id/tv_content1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15.0dip"
            android:text="@string/dialog_privacy_413_content1"
            android:layout_below="@id/tv_title"
            android:layout_centerHorizontal="true" />
        <ScrollView
            android:id="@id/sv_content"
            android:layout_width="fill_parent"
            android:layout_height="350.0dip"
            android:layout_marginTop="15.0dip"
            android:layout_below="@id/tv_content1"
            android:fadeScrollbars="false"
            android:overScrollMode="never">
            <TextView
                android:textSize="12.0sp"
                android:textColor="#ff333333"
                android:id="@id/tv_content2"
                android:paddingBottom="15.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8.0dip"
                android:layout_marginRight="8.0dip"
                android:text="@string/dialog_privacy_413_content2" />
        </ScrollView>
        <View
            android:id="@id/v_location"
            android:background="@drawable/bg_dialog_privacy_413_content_gradient"
            android:layout_width="fill_parent"
            android:layout_height="20.0dip"
            android:layout_alignBottom="@id/sv_content" />
        <TextView
            android:textSize="14.0sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@id/tv_agree"
            android:background="@drawable/bg_dialog_privacy_413_agree_btn"
            android:layout_width="fill_parent"
            android:layout_height="34.0dip"
            android:layout_marginTop="13.0dip"
            android:text="@string/dialog_privacy_413_agree_btn"
            android:layout_below="@id/sv_content" />
    </RelativeLayout>
</RelativeLayout>