<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/rootView"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/ll_dialog"
        android:background="@drawable/bg_dialog_pay_hint"
        android:layout_width="280.0dip"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true">
        <ImageView
            android:id="@id/iv_close"
            android:padding="5.0dip"
            android:layout_width="25.0dip"
            android:layout_height="25.0dip"
            android:layout_marginTop="10.0dip"
            android:layout_marginRight="10.0dip"
            android:src="@drawable/close"
            android:layout_alignParentRight="true" />
        <RelativeLayout
            android:id="@id/rl_switch_account"
            android:background="@drawable/bg_google_account_switch"
            android:layout_width="240.0dip"
            android:layout_height="34.0dip"
            android:layout_marginTop="9.0dip"
            android:layout_below="@id/iv_close"
            android:layout_centerHorizontal="true">
            <TextView
                android:textSize="14.0sp"
                android:textColor="#ff333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/switch_google_accounts"
                android:layout_centerInParent="true" />
        </RelativeLayout>
        <Button
            android:textSize="14.0sp"
            android:textColor="#ffffffff"
            android:id="@id/btn_logout"
            android:background="@drawable/bg_google_login_experience_now"
            android:layout_width="240.0dip"
            android:layout_height="34.0dip"
            android:layout_marginTop="20.0dip"
            android:layout_marginBottom="20.0dip"
            android:text="@string/google_account_log_out"
            android:layout_below="@id/rl_switch_account"
            android:layout_centerHorizontal="true" />
    </RelativeLayout>
</RelativeLayout>