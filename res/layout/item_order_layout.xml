<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/ll_order_root"
        android:background="@drawable/shape_order_bg_normal"
        android:paddingTop="20.0dip"
        android:paddingBottom="20.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_margin="3.0dip">
        <TextView
            android:textSize="16.0sp"
            android:textColor="@color/pay_order_time"
            android:layout_gravity="center_horizontal"
            android:id="@id/tv_order_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1个月" />
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20.0dip">
            <TextView
                android:textSize="12.0sp"
                android:textColor="@color/pay_order_money"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="￥" />
            <TextView
                android:textSize="24.0sp"
                android:textColor="@color/pay_order_money"
                android:id="@id/tv_order_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="68.00" />
        </LinearLayout>
        <TextView
            android:textSize="12.0sp"
            android:textColor="@color/pay_order_old_money"
            android:layout_gravity="center_horizontal"
            android:id="@id/tv_order_old_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5.0dip"
            android:text="￥168.00" />
        <TextView
            android:textSize="10.0sp"
            android:textColor="@color/pay_order_info"
            android:layout_gravity="center_horizontal"
            android:id="@id/tv_order_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20.0dip"
            android:text="尊享一年VIP" />
    </LinearLayout>
</RelativeLayout>