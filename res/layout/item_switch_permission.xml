<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@id/iv_status"
        android:padding="6.0dip"
        android:layout_width="28.0dip"
        android:layout_height="28.0dip"
        android:layout_marginTop="4.0dip" />
    <ImageView
        android:id="@id/iv_setting"
        android:padding="6.0dip"
        android:layout_width="30.0dip"
        android:layout_height="30.0dip"
        android:layout_marginTop="9.0dip"
        android:src="@drawable/switch_permission_setting"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true" />
    <TextView
        android:textSize="14.0sp"
        android:textColor="#ff333333"
        android:id="@id/tv_permission_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9.0dip"
        android:layout_marginStart="6.0dip"
        android:layout_marginEnd="6.0dip"
        android:layout_toStartOf="@id/iv_setting"
        android:layout_toEndOf="@id/iv_status" />
    <TextView
        android:textSize="10.0sp"
        android:textColor="#ff666666"
        android:id="@id/tv_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2.0dip"
        android:layout_marginBottom="6.0dip"
        android:layout_below="@id/tv_permission_name"
        android:layout_marginStart="6.0dip"
        android:layout_marginEnd="6.0dip"
        android:layout_toStartOf="@id/iv_setting"
        android:layout_toEndOf="@id/iv_status" />
</RelativeLayout>