<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center"
    android:orientation="vertical"
    android:id="@id/root"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/root_relative"
        android:layout_width="120.0dip"
        android:layout_height="120.0dip">
        <ImageView
            android:id="@id/iv_sign"
            android:layout_width="52.0dip"
            android:layout_height="52.0dip" />
        <ImageView
            android:id="@id/delete_item"
            android:layout_width="15.0dip"
            android:layout_height="15.0dip"
            android:layout_marginTop="10.0dip"
            android:layout_marginEnd="10.0dip"
            android:layout_alignParentEnd="true" />
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <RelativeLayout
                android:id="@id/item_icon_framelayout"
                android:layout_width="@dimen/main_app_icon_size_recomm"
                android:layout_height="@dimen/main_app_icon_size_recomm"
                android:layout_centerHorizontal="true">
                <ImageView
                    android:id="@id/item_app_icon"
                    android:layout_width="@dimen/main_app_icon_size"
                    android:layout_height="@dimen/main_app_icon_size"
                    android:layout_centerInParent="true"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@id/edit_item"
                    android:visibility="gone"
                    android:layout_width="15.0dip"
                    android:layout_height="15.0dip"
                    android:layout_alignParentEnd="true" />
                <ImageView
                    android:id="@id/item_front"
                    android:layout_width="@dimen/main_app_icon_size"
                    android:layout_height="@dimen/main_app_icon_size"
                    android:layout_centerInParent="true"
                    android:contentDescription="@null" />
                <RelativeLayout
                    android:id="@id/rl_item_mask"
                    android:visibility="gone"
                    android:layout_width="@dimen/main_app_icon_size"
                    android:layout_height="@dimen/main_app_icon_size"
                    android:layout_centerInParent="true">
                    <ImageView
                        android:background="@drawable/bg_not_support"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:contentDescription="@null" />
                    <ImageView
                        android:layout_width="25.0dip"
                        android:layout_height="25.0dip"
                        android:src="@drawable/icon_not_support"
                        android:layout_centerInParent="true"
                        android:contentDescription="@null" />
                </RelativeLayout>
                <ImageView
                    android:id="@id/iv_notification_point"
                    android:visibility="gone"
                    android:layout_width="6.0dip"
                    android:layout_height="6.0dip"
                    android:layout_marginTop="5.0dip"
                    android:src="@drawable/notification_point"
                    android:layout_marginEnd="5.0dip"
                    android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8.0dip"
                android:layout_below="@id/item_icon_framelayout"
                android:layout_centerHorizontal="true">
                <ImageView
                    android:id="@id/hint_point"
                    android:visibility="gone"
                    android:layout_width="6.0dip"
                    android:layout_height="6.0dip"
                    android:layout_marginEnd="4.0dip" />
                <TextView
                    android:textSize="12.0sp"
                    android:textColor="@color/new_text_color"
                    android:ellipsize="end"
                    android:layout_gravity="center"
                    android:id="@id/item_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true" />
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>