<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:background="@color/bg_banner"
    android:layout_width="fill_parent"
    android:layout_height="@dimen/banner_height"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <androidx.viewpager.widget.ViewPager
        android:id="@id/viewpager_native_ad"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />
    <RelativeLayout
        android:id="@id/rl_bottom"
        android:background="@color/bg_banner_bottom_view"
        android:layout_width="fill_parent"
        android:layout_height="40.0dip"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="14.0sp"
            android:textColor="#ffffffff"
            android:id="@id/text"
            android:paddingLeft="5.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="250.0dip"
            android:lines="1"
            android:singleLine="true"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:paddingStart="5.0dip"
            android:layout_toStartOf="@id/title"
            android:layout_alignParentStart="true" />
        <TextView
            android:textSize="12.0sp"
            android:textColor="#ff2dbcfd"
            android:gravity="center"
            android:id="@id/title"
            android:background="@drawable/bg_button_install"
            android:paddingLeft="5.0dip"
            android:paddingRight="5.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5.0dip"
            android:maxWidth="80.0dip"
            android:lines="1"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="5.0dip"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <LinearLayout
        android:gravity="end|center"
        android:orientation="horizontal"
        android:id="@id/ll_indicator"
        android:layout_width="wrap_content"
        android:layout_height="40.0dip"
        android:layout_marginRight="23.0dip"
        android:layout_above="@id/rl_bottom"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="23.0dip"
        android:layout_alignParentEnd="true" />
    <TextView
        android:textColor="#ffffffff"
        android:id="@id/tv_remove_ad"
        android:background="@drawable/bg_remove_ad"
        android:paddingLeft="5.0dip"
        android:paddingRight="5.0dip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5.0dip"
        android:layout_marginTop="5.0dip"
        android:text="@string/banner_remove_ad" />
</RelativeLayout>