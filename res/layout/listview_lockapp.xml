<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:id="@id/lock_game_item_root"
    android:background="@color/security_lock_bg_color"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/lock_game_item_header_layout"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/lock_game_item_header_ll"
            android:background="@color/security_lock_bg_color"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/add_list_header_height">
            <TextView
                android:textSize="16.0sp"
                android:textColor="@color/add_game_app_color"
                android:gravity="center_vertical"
                android:id="@id/lock_game_item_header"
                android:paddingLeft="@dimen/add_list_padding_edge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:paddingStart="16.0dip" />
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/lock_rl_list_item"
        android:paddingLeft="16.0dip"
        android:paddingRight="16.0dip"
        android:layout_width="fill_parent"
        android:layout_height="70.0dip">
        <ImageView
            android:id="@id/iv_app_icon"
            android:layout_width="40.0dip"
            android:layout_height="40.0dip"
            android:layout_centerVertical="true" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@id/LinearLayout1"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_marginLeft="16.0dip"
            android:layout_toRightOf="@id/iv_app_icon"
            android:layout_centerVertical="true"
            android:layout_marginStart="16.0dip"
            android:layout_toEndOf="@id/iv_app_icon">
            <TextView
                android:textSize="16.0sp"
                android:textColor="@color/add_game_app_color"
                android:id="@id/tv_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="16.0dip"
                android:text="程序名称"
                android:layout_marginEnd="16.0dip" />
        </LinearLayout>
        <Button
            android:id="@id/but_lockapp"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="30.0dip"
            android:layout_height="30.0dip"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>
</LinearLayout>