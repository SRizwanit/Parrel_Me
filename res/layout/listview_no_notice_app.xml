<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:id="@id/lock_game_item_root"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/lock_game_item_header_layout"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/lock_game_item_header_ll"
            android:background="#fff8f8f8"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/add_list_header_height">
            <TextView
                android:textSize="12.0sp"
                android:textColor="#ff999999"
                android:gravity="center_vertical"
                android:id="@id/lock_game_item_header"
                android:paddingLeft="@dimen/add_list_padding_edge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:paddingStart="16.0dip" />
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@id/lock_list_header_divider_up"
        android:background="@color/list_divider_color"
        android:layout_width="fill_parent"
        android:layout_height="1.0px" />
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/lock_rl_list_item"
        android:layout_width="fill_parent"
        android:layout_height="64.0dip">
        <ImageView
            android:id="@id/iv_app_icon"
            android:layout_width="40.0dip"
            android:layout_height="40.0dip"
            android:layout_marginLeft="18.0dip"
            android:layout_marginTop="12.0dip"
            android:layout_marginRight="18.0dip"
            android:layout_marginBottom="12.0dip"
            android:layout_centerVertical="true" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@id/LinearLayout1"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_toRightOf="@id/iv_app_icon"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/iv_app_icon">
            <TextView
                android:textSize="14.0sp"
                android:textColor="#ff333333"
                android:id="@id/tv_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="16.0dip"
                android:text="程序名称"
                android:layout_marginEnd="16.0dip" />
        </LinearLayout>
        <Switch
            android:id="@id/switch_btn"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_marginRight="16.0dip"
            android:thumb="@drawable/switch_thumb_selector"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:track="@drawable/switch_track_selector"
            android:layout_marginEnd="16.0dip"
            android:layout_alignParentEnd="true"
            android:showText="false" />
    </RelativeLayout>
    <View
        android:id="@id/list_divider"
        android:background="@color/list_divider_color"
        android:layout_width="fill_parent"
        android:layout_height="1.0px" />
</LinearLayout>