<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/feedback_bg"
    android:descendantFocusability="beforeDescendants"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:background="@color/add_title_bg"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/add_title_height">
        <ImageButton
            android:id="@id/ib_back"
            android:background="@android:color/transparent"
            android:paddingLeft="@dimen/add_back_padding_left"
            android:paddingRight="@dimen/add_back_padding_left"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_centerVertical="true" />
        <TextView
            android:textSize="@dimen/add_list_title_text_size"
            android:textColor="@color/text_color_white"
            android:id="@id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/feedback"
            android:layout_centerInParent="true" />
    </RelativeLayout>
    <FrameLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <ScrollView
            android:id="@id/activity_scroll_view_layout"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:fillViewport="true">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@id/noInput"
                android:background="@color/feedback_bg"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
                <TextView
                    android:textSize="14.0sp"
                    android:textColor="@color/feedback_tx_c"
                    android:gravity="center_vertical"
                    android:layout_gravity="left"
                    android:id="@id/note"
                    android:layout_width="wrap_content"
                    android:layout_height="30.0dip"
                    android:layout_marginLeft="16.0dip"
                    android:text="@string/feedback_title2" />
                <RelativeLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:textSize="@dimen/feedback_tx"
                        android:textColor="@color/feedback_tx_c"
                        android:textColorHint="@color/feedback_tx_hint_c"
                        android:gravity="left"
                        android:id="@id/editTextFeedback"
                        android:paddingLeft="@dimen/feedback_content_margin"
                        android:paddingRight="@dimen/feedback_content_margin"
                        android:layout_width="fill_parent"
                        android:layout_height="220.0dip"
                        android:hint="@string/feedback_content_hint"
                        android:maxLength="128" />
                    <TextView
                        android:textSize="16.0sp"
                        android:textColor="@color/feedback_tx_hint_c"
                        android:gravity="center_vertical"
                        android:layout_gravity="left"
                        android:id="@id/word_num"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="30.0dip"
                        android:text="128"
                        android:layout_toLeftOf="@id/word_num_total"
                        android:layout_alignTop="@id/word_num_total" />
                    <TextView
                        android:textSize="16.0sp"
                        android:textColor="@color/feedback_tx_hint_c"
                        android:gravity="center_vertical"
                        android:layout_gravity="left"
                        android:id="@id/word_num_total"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="30.0dip"
                        android:layout_marginLeft="0.0dip"
                        android:layout_marginRight="@dimen/feedback_bt_r"
                        android:layout_marginBottom="2.0dip"
                        android:text="/128"
                        android:layout_alignRight="@id/editTextFeedback"
                        android:layout_alignBottom="@id/editTextFeedback" />
                </RelativeLayout>
                <TextView
                    android:textSize="14.0sp"
                    android:textColor="@color/feedback_tx_hint_c"
                    android:gravity="center_vertical"
                    android:layout_gravity="left"
                    android:id="@id/tel"
                    android:layout_width="wrap_content"
                    android:layout_height="30.0dip"
                    android:layout_marginLeft="@dimen/feedback_bt_l"
                    android:layout_marginRight="@dimen/feedback_bt_r"
                    android:text="@string/feedback_tel" />
                <RelativeLayout
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/feedback_address_h">
                    <EditText
                        android:textSize="@dimen/feedback_tx"
                        android:textColor="@color/feedback_tx_c"
                        android:textColorHint="@color/feedback_tx_hint_c"
                        android:gravity="center|left"
                        android:id="@id/et_address"
                        android:paddingLeft="@dimen/feedback_content_margin"
                        android:paddingRight="40.0dip"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:layout_marginLeft="0.0dip"
                        android:layout_marginRight="0.0dip"
                        android:hint="@string/feedback_address_hint"
                        android:maxLength="32"
                        android:imeOptions="actionGo" />
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@id/iv_clear"
                        android:paddingLeft="8.0dip"
                        android:paddingRight="8.0dip"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="fill_parent"
                        android:layout_marginRight="10.0dip"
                        android:src="@drawable/btn_clear"
                        android:layout_alignTop="@id/et_address"
                        android:layout_alignParentRight="true" />
                </RelativeLayout>
                <TextView
                    android:textSize="@dimen/feedback_tx"
                    android:textColor="@color/feedback_tx_hint_c"
                    android:gravity="center"
                    android:id="@id/tx_prompt"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/feedback_prompt_l"
                    android:layout_marginTop="@dimen/feedback_prompt_t"
                    android:layout_marginRight="@dimen/feedback_prompt_r"
                    android:text="@string/feedback_prompt" />
                <LinearLayout
                    android:gravity="left"
                    android:layout_gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/feedback_prompt_t"
                    android:layout_marginBottom="@dimen/feedback_prompt_t">
                    <TextView
                        android:textColor="@color/feedback_tx_hint_c"
                        android:textColorLink="@color/text_color_white"
                        android:gravity="center"
                        android:id="@id/tv_qg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="0.0dip"
                        android:textIsSelectable="true" />
                    <View
                        android:layout_width="fill_parent"
                        android:layout_height="6.0dip" />
                    <TextView
                        android:textColor="@color/feedback_tx_hint_c"
                        android:textColorLink="@color/text_color_white"
                        android:gravity="center"
                        android:autoLink="none"
                        android:id="@id/tv_tel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8.0dip"
                        android:textIsSelectable="true" />
                </LinearLayout>
                <Button
                    android:enabled="false"
                    android:textSize="@dimen/feedback_tx2"
                    android:textColor="@color/feedback_tx_bt_c"
                    android:id="@id/button_feedback_submit"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/feedback_bt_h"
                    android:layout_marginLeft="@dimen/feedback_bt_l"
                    android:layout_marginTop="@dimen/grad_content1_mt"
                    android:layout_marginRight="@dimen/feedback_bt_r"
                    android:text="@string/submit"
                    style="@style/big_button" />
            </LinearLayout>
        </ScrollView>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@id/finish"
            android:background="@color/feedback_bg"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <ImageView
                android:background="@drawable/feedbakc_finish"
                android:layout_width="82.0dip"
                android:layout_height="81.0dip"
                android:layout_marginLeft="140.0dip"
                android:layout_marginTop="56.0dip"
                android:layout_marginRight="139.0dip"
                android:scaleType="fitCenter" />
            <TextView
                android:textSize="18.0sp"
                android:textColor="@color/feedback_tx_success"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14.0dip"
                android:text="@string/feedback_submit_success" />
            <TextView
                android:textSize="12.0sp"
                android:textColor="@color/feedback_tx_hint_c"
                android:gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24.0dip"
                android:layout_marginTop="22.0dip"
                android:layout_marginRight="24.0dip"
                android:text="@string/feedback_thank" />
            <Button
                android:textSize="@dimen/feedback_tx2"
                android:textColor="@color/feedback_tx_bt_c"
                android:id="@id/button_feedback_finish"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/feedback_bt_h"
                android:layout_marginLeft="@dimen/feedback_bt_l"
                android:layout_marginTop="25.0dip"
                android:layout_marginRight="@dimen/feedback_bt_r"
                android:text="@string/feedback_submit_close"
                style="@style/big_button" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>