<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/primary_menu_bg_color"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:gravity="center_vertical"
        android:background="@color/add_title_bg"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/add_title_height">
        <ImageButton
            android:id="@id/ib_back"
            android:background="@android:color/transparent"
            android:paddingLeft="@dimen/add_back_padding_left"
            android:paddingRight="@dimen/add_back_padding_left"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent" />
        <TextView
            android:textSize="@dimen/add_list_title_text_size"
            android:textColor="@color/text_color_white"
            android:gravity="center"
            android:id="@id/title"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text="@string/helpcontent"
            android:layout_centerHorizontal="true" />
    </RelativeLayout>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <com.excelliance.kxqp.widget.CustomListView
                android:id="@id/lv_help"
                android:background="#ffc0c0c0"
                android:paddingTop="1.0px"
                android:paddingBottom="1.0px"
                android:scrollbars="none"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:divider="#ffc0c0c0"
                android:dividerHeight="1.0px" />
            <TextView
                android:textSize="14.0sp"
                android:textColor="@color/notice_content"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14.0dip"
                android:text="@string/feedback_content" />
            <TextView
                android:textColor="@color/feedback"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@id/tv_feedback"
                android:background="@drawable/feedback_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="19.0dip"
                android:layout_marginBottom="33.0dip"
                android:text="@string/feedback" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>