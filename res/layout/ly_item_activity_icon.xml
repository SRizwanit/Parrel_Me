<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center"
    android:orientation="vertical"
    android:id="@id/root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/root_relative"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@id/iv_superscript"
            android:visibility="visible"
            android:layout_width="30.0dip"
            android:layout_height="30.0dip"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true" />
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="112.0dip"
            android:layout_height="112.0dip"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true">
            <FrameLayout
                android:layout_width="@dimen/main_app_icon_size_recomm"
                android:layout_height="@dimen/main_app_icon_size_recomm"
                android:layout_marginBottom="6.0dip"
                android:layout_centerInParent="true">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@id/item_app_icon"
                    android:layout_width="@dimen/main_app_icon_size"
                    android:layout_height="@dimen/main_app_icon_size"
                    android:layout_marginLeft="0.0dip"
                    android:layout_marginTop="0.0dip"
                    android:contentDescription="@null" />
                <ImageView
                    android:layout_gravity="center"
                    android:id="@id/item_front"
                    android:layout_width="@dimen/main_app_icon_size"
                    android:layout_height="@dimen/main_app_icon_size"
                    android:layout_marginLeft="0.0dip"
                    android:contentDescription="@null" />
            </FrameLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <ImageView
                    android:id="@id/hint_point"
                    android:visibility="gone"
                    android:layout_width="6.0dip"
                    android:layout_height="6.0dip"
                    android:layout_marginRight="4.0dip" />
                <TextView
                    android:textSize="12.0sp"
                    android:textColor="@color/text_color_app"
                    android:ellipsize="end"
                    android:layout_gravity="center"
                    android:id="@id/item_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="活动"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>