<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:orientation="vertical"
    android:id="@id/full_layout"
    android:background="@color/new_gridview_item_bg"
    android:scrollbars="none"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:splitMotionEvents="false"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include
        android:id="@id/menu_top"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/add_title_height"
        android:layout_alignParentTop="true"
        layout="@layout/lyl_menu_top" />
    <com.excelliance.kxqp.ui.MainScrollView
        android:id="@id/main_scroller"
        android:scrollbars="none"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/menu_top">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/center"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:splitMotionEvents="false">
            <com.excelliance.kxqp.ads.view.NativeBanner
                android:id="@id/nativeBanner"
                android:background="@color/add_title_bg"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/banner_height" />
            <include
                android:layout_width="fill_parent"
                android:layout_height="36.0dip"
                android:layout_marginTop="4.0dip"
                android:layout_marginBottom="6.0dip"
                layout="@layout/layout_incognito_entry" />
            <include
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                layout="@layout/ly_old_center" />
            <View
                android:id="@id/shadow_view"
                android:background="@color/priv_main_color_bg"
                android:focusable="false"
                android:visibility="gone"
                android:clickable="false"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/app_shadow_bg_size" />
            <View
                android:id="@id/shadow_view1"
                android:background="@color/new_gridview_item_bg"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/stream_banner_gap" />
        </LinearLayout>
    </com.excelliance.kxqp.ui.MainScrollView>
    <Button
        android:id="@id/add_but"
        android:background="@drawable/add_main_but"
        android:visibility="gone"
        android:layout_width="@dimen/add_main_but_size"
        android:layout_height="@dimen/add_main_but_size"
        android:layout_marginRight="@dimen/add_main_but_right"
        android:layout_marginBottom="@dimen/add_main_but_bottom"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true" />
    <FrameLayout
        android:id="@id/rl_guide1"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <FrameLayout
            android:background="#ff000000"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:alpha="0.2" />
        <RelativeLayout
            android:id="@id/rl_content"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <TextView
                android:textSize="15.0sp"
                android:textColor="@android:color/white"
                android:id="@id/tv_app_add"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <TextView
                android:textSize="15.0sp"
                android:textColor="@android:color/white"
                android:id="@id/tv_bt_add"
                android:background="@drawable/up"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="24.0dip"
                android:layout_marginBottom="105.0dip"
                android:layout_alignParentRight="true"
                android:layout_alignParentBottom="true" />
        </RelativeLayout>
    </FrameLayout>
    <Button
        android:id="@id/btn_zendesk"
        android:background="@drawable/btn_zendesk"
        android:visibility="gone"
        android:layout_width="56.0dip"
        android:layout_height="56.0dip"
        android:layout_marginLeft="40.0dip"
        android:layout_marginBottom="32.0dip"
        android:layout_alignParentLeft="true"
        android:layout_alignParentBottom="true" />
    <FrameLayout
        android:id="@id/fl_ad_bottom"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/rl_guide"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <ImageView
            android:id="@id/iv_down_arrow"
            android:layout_width="@dimen/dp_10"
            android:layout_height="@dimen/dp_10"
            android:src="@drawable/shape_down_arrow_0099df"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="#ffffffff"
            android:id="@id/tv_guide_content"
            android:background="@drawable/bg_round_0099df_4dp"
            android:paddingLeft="12.0dip"
            android:paddingTop="8.0dip"
            android:paddingRight="12.0dip"
            android:paddingBottom="8.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="200.0dip"
            app:layout_constraintBottom_toTopOf="@id/iv_down_arrow"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>