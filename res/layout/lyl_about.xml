<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:orientation="vertical"
    android:background="#fff2f2f2"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include
        android:id="@id/titleView"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_title_view" />
    <ImageView
        android:id="@id/iv_app_icon"
        android:layout_width="200.0dip"
        android:layout_height="200.0dip"
        android:layout_marginTop="50.0dip"
        android:src="@drawable/icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleView" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/cl_check_upgrade"
        android:background="@drawable/app_list_item_selector"
        android:layout_width="fill_parent"
        android:layout_height="56.0dip"
        android:layout_marginTop="50.0dip"
        android:paddingStart="16.0dip"
        android:paddingEnd="16.0dip"
        app:layout_constraintTop_toBottomOf="@id/iv_app_icon">
        <TextView
            android:textSize="16.0sp"
            android:textColor="@color/add_game_app_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/upgrade"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <TextView
            android:textSize="14.0sp"
            android:textColor="#ff838997"
            android:id="@id/tv_version_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.0.0"
            android:layout_alignParentEnd="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@id/v_split_line"
        android:background="#fff2f2f2"
        android:layout_width="fill_parent"
        android:layout_height="1.0dip"
        app:layout_constraintTop_toBottomOf="@id/cl_check_upgrade" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/rl_aid"
        android:background="#ffffffff"
        android:layout_width="fill_parent"
        android:layout_height="56.0dip"
        android:paddingStart="16.0dip"
        android:paddingEnd="16.0dip"
        app:layout_constraintTop_toBottomOf="@id/v_split_line">
        <TextView
            android:textSize="16.0sp"
            android:textColor="@color/add_game_app_color"
            android:id="@id/tv_aid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User ID:"
            android:layout_alignParentStart="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <TextView
            android:textSize="14.0sp"
            android:textColor="#ffffffff"
            android:id="@id/tv_copy"
            android:background="@drawable/bg_about_aid_copy"
            android:paddingBottom="2.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_aid_copy"
            android:paddingStart="8.0dip"
            android:paddingEnd="8.0dip"
            android:layout_alignParentEnd="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textColor="#ff999999"
        android:gravity="center_horizontal"
        android:id="@id/privacy_policy_and_terms_of_service"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="35.0dip"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>