<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@id/top"
    android:background="@color/add_title_bg"
    android:paddingTop="0.0dip"
    android:paddingBottom="0.0dip"
    android:layout_width="fill_parent"
    android:layout_height="@dimen/add_title_height"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@id/m_menu"
        android:padding="5.0dip"
        android:layout_width="35.0dip"
        android:layout_height="35.0dip"
        android:layout_marginLeft="7.0dip"
        android:src="@drawable/main_menu"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="7.0dip"
        android:layout_alignParentStart="true" />
    <TextView
        android:textSize="20.0sp"
        android:textColor="@color/text_color_white"
        android:id="@id/menu_top_title"
        android:background="@android:color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_name"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true" />
    <ImageView
        android:id="@id/ib_lock"
        android:tag="ib_lock"
        android:background="@android:color/transparent"
        android:layout_width="24.0dip"
        android:layout_height="24.0dip"
        android:layout_marginRight="51.0dip"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="51.0dip"
        android:layout_alignParentEnd="true" />
    <ImageView
        android:id="@id/ib_share"
        android:tag="share_awards"
        android:background="@color/transparent"
        android:visibility="gone"
        android:layout_width="24.0dip"
        android:layout_height="24.0dip"
        android:layout_marginRight="14.0dip"
        android:src="@drawable/share_awards"
        android:layout_toLeftOf="@id/fl_ly"
        android:layout_centerVertical="true"
        android:layout_marginEnd="14.0dip"
        android:layout_toStartOf="@id/fl_ly" />
    <ImageView
        android:id="@id/m_add"
        android:layout_width="25.0dip"
        android:layout_height="25.0dip"
        android:layout_marginRight="12.0dip"
        android:src="@drawable/main_vip"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="12.0dip"
        android:layout_alignParentEnd="true" />
    <Button
        android:textSize="16.0sp"
        android:textColor="@color/text_color_white"
        android:layout_gravity="center_vertical"
        android:id="@id/ib_menuorcontent"
        android:tag="ib_menuorcontent"
        android:background="@color/transparent"
        android:visibility="gone"
        android:layout_width="24.0dip"
        android:layout_height="24.0dip"
        android:layout_marginRight="12.0dip"
        android:scaleType="centerInside"
        android:lines="1"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="12.0dip"
        android:layout_alignParentEnd="true" />
    <FrameLayout
        android:id="@id/fl_ly"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="fill_parent"
        android:layout_marginRight="10.0dip"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="10.0dip"
        android:layout_alignParentEnd="true">
        <ImageView
            android:layout_gravity="center"
            android:id="@id/iv_icon"
            android:visibility="gone"
            android:layout_width="24.0dip"
            android:layout_height="24.0dip"
            android:src="@drawable/main_vip" />
        <ImageView
            android:layout_gravity="end|center|top"
            android:id="@id/notification_img"
            android:background="@drawable/notification_point"
            android:visibility="gone"
            android:layout_width="8.0dip"
            android:layout_height="8.0dip"
            android:layout_marginTop="10.0dip"
            android:layout_centerVertical="true" />
    </FrameLayout>
    <TextView
        android:textSize="@dimen/first_start_ins_text_size"
        android:textColor="@color/text_color_white"
        android:gravity="center"
        android:id="@id/tv_cancel"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="fill_parent"
        android:layout_marginLeft="@dimen/add_back_padding_left"
        android:minWidth="25.0dip"
        android:text="@string/cancel_information"
        android:layout_alignParentLeft="true"
        android:layout_marginStart="12.0dip"
        android:layout_alignParentStart="true" />
</RelativeLayout>