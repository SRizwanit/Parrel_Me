<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ScrollView
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <com.excelliance.kxqp.ui.view.RelativeLayoutForDialog
            android:layout_gravity="center"
            android:id="@id/custom_relaLayout"
            android:visibility="visible"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <RelativeLayout
                android:id="@id/all_view_relative"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10.0dip"
                android:layout_marginRight="10.0dip"
                android:layout_centerInParent="true"
                android:layout_marginStart="10.0dip"
                android:layout_marginEnd="10.0dip">
                <LinearLayout
                    android:gravity="start"
                    android:orientation="vertical"
                    android:id="@id/dialog_main"
                    android:background="@drawable/pop_window_bg"
                    android:paddingTop="16.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20.0dip"
                    android:layout_marginTop="35.0dip"
                    android:layout_marginRight="20.0dip"
                    android:layout_marginBottom="35.0dip"
                    android:layout_centerInParent="true"
                    android:layout_marginStart="20.0dip"
                    android:layout_marginEnd="20.0dip">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingLeft="18.0dip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="18.0dip">
                        <ImageView
                            android:background="@drawable/pop_custom_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                        <TextView
                            android:textSize="14.0sp"
                            android:textColor="@color/new_text_color"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="6.0dip"
                            android:text="@string/pop_dialog_add_icon"
                            android:layout_marginStart="6.0dip" />
                    </LinearLayout>
                    <ImageView
                        android:layout_gravity="center_horizontal"
                        android:id="@id/added_icon_img"
                        android:layout_width="36.0dip"
                        android:layout_height="36.0dip"
                        android:layout_marginTop="10.0dip"
                        android:layout_marginBottom="10.0dip" />
                    <TextView
                        android:textSize="14.0sp"
                        android:textColor="@color/new_text_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="36.0dip"
                        android:layout_marginBottom="16.0dip"
                        android:text="@string/pop_dialog_add_icon_hint"
                        android:layout_marginStart="36.0dip" />
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <RelativeLayout
                            android:id="@id/dialog_photo_lay"
                            android:layout_width="48.0dip"
                            android:layout_height="48.0dip">
                            <ImageView
                                android:layout_width="36.0dip"
                                android:layout_height="36.0dip"
                                android:src="@drawable/custom_photo"
                                android:layout_centerInParent="true" />
                            <ImageView
                                android:id="@id/dialog_photo_check"
                                android:background="@drawable/dialog_check"
                                android:visibility="gone"
                                android:layout_width="15.0dip"
                                android:layout_height="15.0dip"
                                android:layout_alignParentRight="true" />
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@id/dialog_edit_lay"
                            android:layout_width="48.0dip"
                            android:layout_height="48.0dip"
                            android:layout_marginLeft="15.0dip"
                            android:layout_marginStart="15.0dip">
                            <ImageView
                                android:layout_width="39.0dip"
                                android:layout_height="39.0dip"
                                android:src="@drawable/custom_edit"
                                android:layout_centerInParent="true" />
                            <ImageView
                                android:id="@id/dialog_edit_check"
                                android:background="@drawable/dialog_check"
                                android:visibility="gone"
                                android:layout_width="15.0dip"
                                android:layout_height="15.0dip"
                                android:layout_alignParentRight="true" />
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@id/dialog_game_lay"
                            android:layout_width="48.0dip"
                            android:layout_height="48.0dip"
                            android:layout_marginLeft="15.0dip"
                            android:layout_marginStart="15.0dip">
                            <ImageView
                                android:layout_width="36.0dip"
                                android:layout_height="36.0dip"
                                android:src="@drawable/custom_game"
                                android:layout_centerInParent="true" />
                            <ImageView
                                android:id="@id/dialog_game_check"
                                android:background="@drawable/dialog_check"
                                android:visibility="gone"
                                android:layout_width="15.0dip"
                                android:layout_height="15.0dip"
                                android:layout_alignParentRight="true"
                                android:layout_alignParentEnd="true" />
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@id/dialog_calendar_lay"
                            android:layout_width="48.0dip"
                            android:layout_height="48.0dip"
                            android:layout_marginLeft="15.0dip"
                            android:layout_marginStart="15.0dip">
                            <ImageView
                                android:id="@id/dialog_home_img"
                                android:layout_width="36.0dip"
                                android:layout_height="36.0dip"
                                android:src="@drawable/custom_more"
                                android:layout_centerInParent="true" />
                            <ImageView
                                android:id="@id/dialog_calendar_check"
                                android:background="@drawable/dialog_check"
                                android:visibility="gone"
                                android:layout_width="15.0dip"
                                android:layout_height="15.0dip"
                                android:layout_alignParentRight="true"
                                android:layout_alignParentEnd="true" />
                        </RelativeLayout>
                    </LinearLayout>
                    <TextView
                        android:textSize="14.0sp"
                        android:textColor="@color/new_text_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="36.0dip"
                        android:layout_marginTop="10.0dip"
                        android:layout_marginBottom="10.0dip"
                        android:text="@string/pop_dialog_add_name_hint"
                        android:layout_marginStart="36.0dip" />
                    <EditText
                        android:textColor="@color/pop_edit_text"
                        android:textColorHint="@color/pop_edit_hit_text"
                        android:layout_gravity="center_horizontal"
                        android:id="@id/pop_name_edit"
                        android:background="@drawable/dialog_edit_bg"
                        android:paddingLeft="5.0dip"
                        android:layout_width="232.0dip"
                        android:layout_height="30.0dip"
                        android:layout_marginTop="5.0dip"
                        android:layout_marginBottom="5.0dip"
                        android:maxLines="1"
                        android:maxLength="15"
                        android:paddingStart="5.0dip" />
                    <Button
                        android:textSize="15.0sp"
                        android:textColor="@color/user_item_normal_white"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:id="@id/pop_sure_but"
                        android:background="@drawable/pop_but_bg"
                        android:layout_width="100.0dip"
                        android:layout_height="30.0dip"
                        android:layout_marginTop="10.0dip"
                        android:layout_marginBottom="10.0dip"
                        android:text="@string/pop_dialog_sure"
                        android:lines="1" />
                </LinearLayout>
                <ImageView
                    android:id="@id/dialog_image_back"
                    android:layout_width="40.0dip"
                    android:layout_height="40.0dip"
                    android:src="@drawable/pop_custom_icon_out"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentEnd="true" />
            </RelativeLayout>
        </com.excelliance.kxqp.ui.view.RelativeLayoutForDialog>
    </ScrollView>
</RelativeLayout>