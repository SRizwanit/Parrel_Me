<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:gravity="center"
    android:orientation="vertical"
    android:background="@null"
    android:clickable="true"
    android:descendantFocusability="beforeDescendants"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="120.0dip"
        android:layout_centerInParent="true">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@id/recomm_item_app_icon"
            android:visibility="visible"
            android:layout_width="@dimen/main_app_icon_size"
            android:layout_height="@dimen/main_app_icon_size"
            android:layout_marginBottom="8.0dip"
            android:contentDescription="@null" />
        <TextView
            android:textSize="12.0sp"
            android:textColor="@color/app_text_color"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@id/recomm_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/da_app_name"
            android:maxLines="1"
            android:includeFontPadding="false" />
        <View
            android:id="@id/recomm_divider"
            android:background="@color/list_divider_color"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="1.0px"
            android:layout_marginTop="@dimen/recomm_divider_margin_top" />
    </LinearLayout>
</RelativeLayout>