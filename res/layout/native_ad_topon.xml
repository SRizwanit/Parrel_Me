<?xml version="1.0" encoding="utf-8"?>
<com.secmtp.sdk.nativead.api.ATNativeAdView
    android:id="@id/root_ad_view"
    android:layout_width="fill_parent"
    android:layout_height="@dimen/banner_height"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/rl_self_render_view"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <FrameLayout
            android:id="@id/native_ad_content_image_area"
            android:layout_width="fill_parent"
            android:layout_height="180.0dip"
            android:layout_alignParentTop="true" />
        <RelativeLayout
            android:id="@id/rl_bottom"
            android:layout_width="fill_parent"
            android:layout_height="40.0dip"
            android:layout_alignParentBottom="true">
            <TextView
                android:textSize="14.0sp"
                android:textColor="#ffffffff"
                android:id="@id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_centerVertical="true"
                android:paddingStart="5.0dip"
                android:layout_toStartOf="@id/tv_cta"
                android:layout_alignParentStart="true" />
            <Button
                android:textSize="12.0sp"
                android:textColor="#ff2dbcfd"
                android:gravity="center"
                android:id="@id/tv_cta"
                android:background="@drawable/bg_button_install"
                android:paddingLeft="5.0dip"
                android:paddingRight="5.0dip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5.0dip"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true" />
        </RelativeLayout>
    </RelativeLayout>
</com.secmtp.sdk.nativead.api.ATNativeAdView>