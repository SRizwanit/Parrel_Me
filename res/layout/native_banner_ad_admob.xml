<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView
    android:layout_width="fill_parent"
    android:layout_height="@dimen/dp_120"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <ImageView
            android:id="@id/ad_image"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:scaleType="fitXY" />
        <RelativeLayout
            android:id="@id/rl_bottom"
            android:background="@drawable/bg_mc_banner_bottom_view"
            android:layout_width="fill_parent"
            android:layout_height="40.0dip"
            android:layout_alignParentBottom="true">
            <TextView
                android:textSize="14.0sp"
                android:textColor="#ffffffff"
                android:id="@id/ad_headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="280.0dip"
                android:singleLine="true"
                android:layout_centerVertical="true"
                android:paddingStart="5.0dip"
                android:layout_alignParentStart="true" />
            <TextView
                android:textSize="12.0sp"
                android:textColor="#ff2dbcfd"
                android:gravity="center"
                android:id="@id/ad_call_to_action"
                android:background="@drawable/bg_button_install"
                android:paddingLeft="5.0dip"
                android:paddingRight="5.0dip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Learn More"
                android:layout_centerVertical="true"
                android:layout_marginEnd="5.0dip"
                android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <TextView
            android:textSize="12.0sp"
            android:textColor="#ffffffff"
            android:background="#33000000"
            android:padding="2.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ad_mark"
            android:layout_alignParentStart="true" />
    </RelativeLayout>
</com.google.android.gms.ads.nativead.NativeAdView>