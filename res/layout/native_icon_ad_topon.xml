<?xml version="1.0" encoding="utf-8"?>
<com.secmtp.sdk.nativead.api.ATNativeAdView
    android:id="@id/root_ad_view"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/rl_self_render_view"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <RelativeLayout
            android:layout_gravity="center"
            android:id="@id/root_relative"
            android:layout_width="120.0dip"
            android:layout_height="120.0dip">
            <ImageView
                android:id="@id/iv_sign"
                android:layout_width="30.0dip"
                android:layout_height="30.0dip"
                android:src="@drawable/ad_sign" />
            <RelativeLayout
                android:id="@id/rl_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <RelativeLayout
                    android:id="@id/rl_icon"
                    android:layout_width="@dimen/main_app_icon_size_recomm"
                    android:layout_height="@dimen/main_app_icon_size_recomm"
                    android:layout_centerHorizontal="true">
                    <FrameLayout
                        android:id="@id/native_ad_logo_container"
                        android:background="@drawable/bg_native_icon"
                        android:visibility="gone"
                        android:layout_width="@dimen/main_app_icon_size"
                        android:layout_height="@dimen/main_app_icon_size"
                        android:layout_centerInParent="true" />
                </RelativeLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dip"
                    android:layout_below="@id/rl_icon"
                    android:layout_centerHorizontal="true">
                    <ImageView
                        android:id="@id/hint_point"
                        android:visibility="gone"
                        android:layout_width="6.0dip"
                        android:layout_height="6.0dip"
                        android:layout_marginEnd="4.0dip" />
                    <com.excelliance.kxqp.ui.view.AlwaysMarqueeTextView
                        android:textSize="12.0sp"
                        android:textColor="@color/app_text_color_white"
                        android:id="@id/tv_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/style_single_auto_scroll_text" />
                </LinearLayout>
            </RelativeLayout>
            <TextView
                android:textSize="8.0sp"
                android:textColor="@color/app_text_color_white"
                android:id="@id/tv_cta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9.0dip"
                android:layout_below="@id/rl_content"
                android:layout_centerHorizontal="true" />
        </RelativeLayout>
    </RelativeLayout>
</com.secmtp.sdk.nativead.api.ATNativeAdView>