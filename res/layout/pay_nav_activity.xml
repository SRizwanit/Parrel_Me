<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/pay_nav_topll"
        android:background="@color/pay_nav_title"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/add_title_height">
        <ImageView
            android:id="@id/pay_nav_back"
            android:paddingLeft="16.0dip"
            android:paddingRight="32.0dip"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent" />
        <TextView
            android:textSize="20.0sp"
            android:textColor="#ffffffff"
            android:gravity="center_vertical"
            android:id="@id/pay_nat_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pay_nav_top_tv" />
    </LinearLayout>
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <ScrollView
            android:background="@color/pay_nav_content"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:overScrollMode="never">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:background="@color/pay_nav_content"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@id/pay_nav_info_ll"
                    android:paddingTop="8.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16.0sp"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:id="@id/pay_price_info_tv1"
                        android:layout_width="wrap_content"
                        android:layout_height="72.0dip"
                        android:text="@string/pay_nav_title" />
                    <RelativeLayout
                        android:gravity="center"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <RadioGroup
                            android:orientation="vertical"
                            android:id="@id/pay_nav_radiogroup"
                            android:layout_width="wrap_content"
                            android:layout_height="112.0dip"
                            android:layout_marginLeft="16.0dip">
                            <RadioButton
                                android:gravity="center"
                                android:id="@id/pay_nav_rb1"
                                android:background="@null"
                                android:layout_width="wrap_content"
                                android:layout_height="0.0dip"
                                android:button="@null"
                                android:layout_weight="1.0" />
                            <RadioButton
                                android:id="@id/pay_nav_rb2"
                                android:background="@null"
                                android:layout_width="wrap_content"
                                android:layout_height="0.0dip"
                                android:button="@null"
                                android:layout_weight="1.0" />
                        </RadioGroup>
                        <RelativeLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:id="@id/pay_price_rl"
                            android:layout_width="fill_parent"
                            android:layout_height="56.0dip"
                            android:layout_toRightOf="@id/pay_nav_radiogroup">
                            <TextView
                                android:textSize="16.0sp"
                                android:textColor="#ffffd12f"
                                android:id="@id/annual_price"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="16.0sp"
                                android:text="@string/pay_nav_year_price"
                                android:layout_alignParentRight="true" />
                            <TextView
                                android:textSize="16.0sp"
                                android:textColor="#ffffffff"
                                android:ellipsize="end"
                                android:id="@id/pay_nav_year"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="10.0dip"
                                android:text="@string/pay_nav_buy_year"
                                android:maxLines="1"
                                android:layout_toLeftOf="@id/annual_price" />
                        </RelativeLayout>
                        <RelativeLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="fill_parent"
                            android:layout_height="56.0dip"
                            android:layout_toRightOf="@id/pay_nav_radiogroup"
                            android:layout_below="@id/pay_price_rl">
                            <TextView
                                android:textSize="16.0sp"
                                android:textColor="#ffffd12f"
                                android:id="@id/monthly_price"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="16.0sp"
                                android:text="@string/pay_nav_month_price"
                                android:layout_alignParentRight="true" />
                            <TextView
                                android:textSize="16.0sp"
                                android:textColor="#ffffffff"
                                android:ellipsize="end"
                                android:id="@id/pay_nav_month"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="10.0dip"
                                android:text="@string/pay_nav_buy_month"
                                android:maxLines="1"
                                android:layout_toLeftOf="@id/monthly_price" />
                        </RelativeLayout>
                    </RelativeLayout>
                    <RelativeLayout
                        android:layout_width="fill_parent"
                        android:layout_height="106.0dip">
                        <Button
                            android:textSize="18.0sp"
                            android:textStyle="bold"
                            android:textColor="#ffffffff"
                            android:id="@id/pay_now_bt"
                            android:background="@drawable/pay_buttong_bg"
                            android:layout_width="280.0dip"
                            android:layout_height="48.0dip"
                            android:text="@string/pay_nav_nextstep"
                            android:layout_centerInParent="true" />
                        <ImageView
                            android:id="@id/anim_img"
                            android:clickable="false"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="26.0dip"
                            android:layout_marginTop="10.0dip" />
                    </RelativeLayout>
                </LinearLayout>
                <TextView
                    android:background="#ff475f8f"
                    android:layout_width="fill_parent"
                    android:layout_height="1.0dip" />
                <LinearLayout
                    android:orientation="vertical"
                    android:paddingLeft="16.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16.0sp"
                        android:textColor="#ffffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28.0dip"
                        android:layout_marginBottom="20.0dip"
                        android:text="@string/pay_nav_more_features" />
                    <RelativeLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20.0dip">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="16.0sp"
                                android:textColor="#ff9ca3af"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pay_nav_feature1_title" />
                            <TextView
                                android:textSize="16.0sp"
                                android:textColor="#ff9ca3af"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pay_nav_feature1_content" />
                        </LinearLayout>
                        <ImageView
                            android:id="@id/pay_checked"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="16.0dip"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true" />
                    </RelativeLayout>
                    <RelativeLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20.0dip">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="16.0sp"
                                android:textColor="#ff9ca3af"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pay_nav_feature2_title" />
                            <TextView
                                android:textSize="16.0sp"
                                android:textColor="#ff9ca3af"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pay_nav_feature2_content" />
                        </LinearLayout>
                        <ImageView
                            android:id="@id/pay_checked2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="16.0dip"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true" />
                    </RelativeLayout>
                    <RelativeLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="16.0sp"
                                android:textColor="#ff9ca3af"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pay_nav_feature3_title" />
                            <TextView
                                android:textSize="16.0sp"
                                android:textColor="#ff9ca3af"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pay_nav_feature3_content" />
                        </LinearLayout>
                        <ImageView
                            android:id="@id/pay_checked3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="16.0dip"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true" />
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <TextView
            android:background="#32000000"
            android:layout_width="fill_parent"
            android:layout_height="2.0dip" />
    </RelativeLayout>
</LinearLayout>