<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/ll_folder_dialog"
    android:visibility="visible"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@id/ll_dialog"
        android:background="@drawable/add_delete_bg"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="7.0dip"
        android:layout_centerVertical="true"
        android:paddingStart="@dimen/folder_dialog_padding"
        android:paddingEnd="@dimen/folder_dialog_padding"
        android:layout_marginStart="26.0dip"
        android:layout_marginEnd="26.0dip">
        <TextView
            android:textSize="18.0sp"
            android:textColor="#ff03a9f4"
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:id="@id/tx_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16.0dip"
            android:layout_marginBottom="16.0dip"
            android:text="提示" />
        <TextView
            android:textSize="16.0sp"
            android:textColor="#ff444444"
            android:gravity="start|center"
            android:id="@id/tx_message"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingStart="5.0dip"
            android:paddingEnd="5.0dip" />
        <LinearLayout
            android:layout_gravity="start"
            android:orientation="horizontal"
            android:id="@id/ll_check_box_never_remind"
            android:paddingTop="20.0dip"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <CheckBox
                android:id="@id/check_box_never_remind"
                android:background="@drawable/check_box_update_never_remind_bg"
                android:layout_width="15.0dip"
                android:layout_height="15.0dip"
                android:button="@null"
                android:layout_marginStart="5.0dip" />
            <TextView
                android:textSize="10.0sp"
                android:textColor="#ff666666"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/remind_never"
                android:layout_marginStart="10.0dip" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/ll_view"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25.0dip"
            android:layout_marginStart="10.0dip">
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/rl_item1"
                android:visibility="gone"
                android:layout_width="80.0dip"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:layout_width="30.0dip"
                    android:layout_height="30.0dip"
                    android:src="@drawable/qx_sms" />
                <TextView
                    android:textSize="13.0sp"
                    android:textColor="#ff444444"
                    android:gravity="center"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5.0dip"
                    android:text="@string/permission_name_messages"
                    android:singleLine="true"
                    android:paddingStart="10.0dip"
                    android:paddingEnd="10.0dip" />
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/rl_item2"
                android:visibility="gone"
                android:layout_width="80.0dip"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:layout_width="30.0dip"
                    android:layout_height="30.0dip"
                    android:src="@drawable/qx_phone" />
                <TextView
                    android:textSize="13.0sp"
                    android:textColor="#ff444444"
                    android:gravity="center"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5.0dip"
                    android:text="@string/permission_name_phone"
                    android:singleLine="true"
                    android:paddingStart="10.0dip"
                    android:paddingEnd="10.0dip" />
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/rl_item3"
                android:visibility="gone"
                android:layout_width="80.0dip"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:layout_width="30.0dip"
                    android:layout_height="30.0dip"
                    android:src="@drawable/qx_call_log" />
                <TextView
                    android:textSize="13.0sp"
                    android:textColor="#ff444444"
                    android:gravity="center"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5.0dip"
                    android:text="@string/permission_name_calllog"
                    android:singleLine="true"
                    android:paddingStart="10.0dip"
                    android:paddingEnd="10.0dip" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/ll_button"
            android:layout_width="fill_parent"
            android:layout_height="40.0dip"
            android:layout_marginTop="24.0dip"
            android:layout_marginBottom="13.0dip"
            android:layout_marginStart="10.0dip"
            android:layout_marginEnd="10.0dip">
            <TextView
                android:textSize="17.0sp"
                android:textColor="@color/dialog_button_left_text_color"
                android:gravity="center"
                android:id="@id/bt_cancel"
                android:background="@drawable/dialog_bt_left_selector"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_weight="1.0"
                android:layout_marginStart="6.0dip"
                android:layout_marginEnd="6.0dip" />
            <TextView
                android:textSize="17.0sp"
                android:textColor="@color/dialog_button_right_text_color"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@id/bt_sure"
                android:background="@drawable/dialog_permission_bt_right_selector"
                android:visibility="visible"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_weight="1.0"
                android:layout_marginStart="6.0dip"
                android:layout_marginEnd="6.0dip" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>