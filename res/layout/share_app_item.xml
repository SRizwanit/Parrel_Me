<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center"
    android:orientation="vertical"
    android:id="@id/share_root"
    android:background="@color/ad_color_555555"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:orientation="vertical"
        android:layout_width="82.0dip"
        android:layout_height="82.0dip">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <FrameLayout
                android:layout_gravity="center_horizontal"
                android:layout_width="@dimen/main_app_icon_size"
                android:layout_height="@dimen/main_app_icon_size"
                android:layout_marginBottom="8.0dip">
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@id/share_item_app_icon"
                    android:layout_width="@dimen/main_app_icon_size"
                    android:layout_height="@dimen/main_app_icon_size"
                    android:layout_marginLeft="0.0dip"
                    android:layout_marginTop="0.0dip"
                    android:contentDescription="@null" />
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@id/share_item_front"
                    android:layout_width="@dimen/main_app_icon_size"
                    android:layout_height="@dimen/main_app_icon_size"
                    android:layout_marginLeft="0.0dip"
                    android:contentDescription="@null" />
                <ImageView
                    android:layout_gravity="center"
                    android:id="@id/item_uid"
                    android:visibility="gone"
                    android:layout_width="@dimen/main_app_icon_size_share"
                    android:layout_height="@dimen/main_app_icon_size_share"
                    android:layout_marginLeft="0.0dip"
                    android:contentDescription="@null" />
                <com.excelliance.kxqp.platforms.CircleProgressView
                    android:id="@id/share_circle_progress_view"
                    android:visibility="gone"
                    android:layout_width="@dimen/main_app_icon_size"
                    android:layout_height="@dimen/main_app_icon_size"
                    android:layout_marginLeft="0.0dip" />
                <ImageView
                    android:layout_gravity="center|left|top"
                    android:id="@id/share_app_not_install"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@null" />
                <ImageView
                    android:layout_gravity="center|right|top"
                    android:id="@id/share_app_new_icon"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@null" />
                <ImageView
                    android:layout_gravity="center|right|top"
                    android:id="@id/share_delete_markView"
                    android:visibility="gone"
                    android:layout_width="20.0dip"
                    android:layout_height="20.0dip"
                    android:contentDescription="@null" />
                <ImageView
                    android:layout_gravity="center|left|top"
                    android:id="@id/share_shortcut_markView"
                    android:visibility="gone"
                    android:layout_width="20.0dip"
                    android:layout_height="20.0dip"
                    android:contentDescription="@null" />
                <ImageView
                    android:layout_gravity="bottom|center|right"
                    android:id="@id/share_app_download_icon"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@null" />
            </FrameLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@id/share_hint_point"
                    android:visibility="gone"
                    android:layout_width="6.0dip"
                    android:layout_height="6.0dip"
                    android:layout_marginRight="4.0dip" />
                <TextView
                    android:textSize="12.0sp"
                    android:textColor="@color/app_text_color_white"
                    android:ellipsize="end"
                    android:gravity="bottom"
                    android:layout_gravity="center"
                    android:id="@id/share_item_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true" />
            </LinearLayout>
            <View
                android:id="@id/share_dual_opened_divider"
                android:background="@color/list_divider_color"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="1.0px"
                android:layout_marginTop="@dimen/recomm_divider_margin_top" />
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>