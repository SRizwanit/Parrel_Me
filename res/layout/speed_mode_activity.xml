<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:orientation="vertical"
    android:background="@color/user_center_bg"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@id/tools_lock_top"
        android:background="@color/add_title_bg"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/add_title_height">
        <ImageView
            android:id="@id/back"
            android:paddingLeft="@dimen/add_back_padding_left"
            android:paddingTop="5.0dip"
            android:paddingRight="@dimen/add_back_padding_left"
            android:paddingBottom="5.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/button_back"
            android:layout_centerVertical="true" />
        <TextView
            android:textSize="18.0sp"
            android:textColor="@color/text_color_white"
            android:id="@id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/speed_mode"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true" />
    </RelativeLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@id/ll_mode_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tools_lock_top">
        <RelativeLayout
            android:background="@color/user_item_normal_white"
            android:layout_width="fill_parent"
            android:layout_height="48.0dip"
            android:layout_marginTop="5.0dip">
            <View
                android:background="@color/edit_bg"
                android:layout_width="fill_parent"
                android:layout_height="1.0px" />
            <TextView
                android:textSize="16.0sp"
                android:textColor="@color/image_item_text_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14.0dip"
                android:text="@string/speed_mode"
                android:layout_centerVertical="true" />
            <com.excelliance.kxqp.widget.CustomToggleButton
                android:id="@id/private_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="13.0dip"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true" />
            <View
                android:background="@color/edit_bg"
                android:layout_width="fill_parent"
                android:layout_height="1.0px"
                android:layout_alignParentBottom="true" />
        </RelativeLayout>
        <TextView
            android:textColor="@color/image_item_text_color"
            android:paddingLeft="@dimen/add_list_padding_edge"
            android:paddingRight="@dimen/add_list_padding_edge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22.0dip"
            android:text="@string/speed_mode_desc" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@id/ll_mode_desc_divider"
        android:paddingLeft="@dimen/add_list_padding_edge"
        android:paddingTop="@dimen/add_list_padding_edge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/ll_mode_desc">
        <View
            android:id="@id/desc_header_divider"
            android:background="@color/secondary_gray_color"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="1.0px" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_below="@id/ll_mode_desc_divider">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@id/ll_loading_all"
            android:visibility="invisible"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="正在加载信息..." />
        </LinearLayout>
        <ListView
            android:id="@id/app_listview_app"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:cacheColorHint="@color/blue_press"
            android:divider="@null"
            android:overScrollMode="never" />
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@id/add_no_app_layout"
        android:background="@color/security_bg_color"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_below="@id/tools_lock_top">
        <TextView
            android:textSize="22.0sp"
            android:textColor="@color/primary_gray_color"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_add_app" />
    </LinearLayout>
</RelativeLayout>