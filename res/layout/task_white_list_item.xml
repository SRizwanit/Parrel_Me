<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/task_white_list_item_bg"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/ll_category"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@id/view_gap"
            android:background="@color/task_white_list_bg"
            android:layout_width="fill_parent"
            android:layout_height="12.0dip" />
        <TextView
            android:textSize="15.0sp"
            android:id="@id/textView_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15.0dip"
            android:layout_marginTop="13.0dip"
            android:layout_marginStart="15.0dip" />
        <View
            android:background="@color/task_white_list_item_divider"
            android:layout_width="fill_parent"
            android:layout_height="1.0dip"
            android:layout_marginLeft="15.0dip"
            android:layout_marginTop="12.0dip"
            android:layout_marginRight="15.0dip" />
    </LinearLayout>
    <RelativeLayout
        android:id="@id/rl_item"
        android:paddingLeft="15.0dip"
        android:paddingRight="15.0dip"
        android:layout_width="fill_parent"
        android:layout_height="58.0dip">
        <ImageView
            android:id="@id/iv_appIcon"
            android:layout_width="38.0dip"
            android:layout_height="38.0dip"
            android:layout_centerVertical="true" />
        <TextView
            android:id="@id/tv_appName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18.0dip"
            android:layout_toRightOf="@id/iv_appIcon"
            android:layout_centerVertical="true"
            android:layout_marginStart="18.0dip"
            android:layout_toEndOf="@id/iv_appIcon" />
        <ImageView
            android:id="@id/iv_checkBox"
            android:layout_width="17.0dip"
            android:layout_height="17.0dip"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>
</LinearLayout>